---
import Glyph from './Glyph.astro';
import { REPO } from '../data/nav';
import { DEFAULT_LOCALE, dictionary } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dictionary(locale).install;

const RELEASES = `${REPO}/releases`;

interface Platform {
  readonly id: keyof typeof strings.note;
  readonly label: string;
  readonly icon: string;
  /** A command to paste, or release assets to download. */
  readonly command?: string;
  readonly files?: readonly string[];
}

/**
 * Commands and asset names come from `docs/INSTALL.md`. Any change there has
 * to land here in the same commit — a stale install line is the most expensive
 * typo on the site. Assets link through `releases/latest/download/`, the same
 * stable URLs `docs/INSTALL.md` uses for the Linux packages.
 */
const PLATFORMS: readonly Platform[] = [
  {
    id: 'linux',
    label: 'Linux',
    icon: 'square-terminal',
    command:
      'curl -fsSL https://raw.githubusercontent.com/0xErwin1/dbflux/main/scripts/install.sh | sudo bash',
  },
  { id: 'arch', label: 'Arch', icon: 'square-terminal', command: 'paru -S dbflux' },
  {
    id: 'nix',
    label: 'Nix',
    icon: 'layers',
    command: 'nix profile install github:0xErwin1/dbflux',
  },
  {
    id: 'macos',
    label: 'macOS',
    icon: 'download',
    files: ['dbflux-macos-arm64.dmg', 'dbflux-macos-amd64.dmg'],
  },
  {
    id: 'windows',
    label: 'Windows',
    icon: 'download',
    files: ['dbflux-windows-amd64-setup.exe', 'dbflux-windows-amd64.zip'],
  },
];
---

<section id="install" class="install shell reveal-group">
  <div class="install__copy">
    <p class="eyebrow">{strings.eyebrow}</p>
    <h2 class="display display--compact">{strings.title}</h2>
    <p class="install__body">{strings.body}</p>
    <a class="go" href={RELEASES} rel="noopener">
      {strings.all_downloads}
      <Glyph name="external-link" size={13} class="go__chev" />
    </a>
  </div>

  <div class="install__card c18" data-install>
    <div class="install__tabs" role="tablist" aria-label={strings.platforms_label}>
      {
        PLATFORMS.map((platform, index) => (
          <button
            type="button"
            role="tab"
            id={`install-tab-${platform.id}`}
            class="install__tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`install-panel-${platform.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-install-tab={platform.id}
          >
            <Glyph name={platform.icon} size={15} />
            {platform.label}
          </button>
        ))
      }
    </div>

    {
      PLATFORMS.map((platform, index) => (
        <div
          class="install__panel"
          role="tabpanel"
          id={`install-panel-${platform.id}`}
          aria-labelledby={`install-tab-${platform.id}`}
          data-install-panel={platform.id}
          data-copy-text={platform.command ?? platform.files?.join('\n')}
          hidden={index !== 0}
        >
          <div class="install__lines">
            {platform.command && (
              <div class="install__line mono">
                <span class="install__prompt">$</span>
                <span class="install__command">{platform.command}</span>
              </div>
            )}
            {platform.files?.map((file) => (
              <a
                class="install__line install__file mono"
                href={`${RELEASES}/latest/download/${file}`}
                rel="noopener"
              >
                <Glyph name="file-down" size={17} style="margin-top: 3px" />
                <span>{file}</span>
              </a>
            ))}
          </div>
          <div class="install__foot">
            <span class="install__note">{strings.note[platform.id]}</span>
            <button type="button" class="install__copy-button c7" data-install-copy>
              <Glyph name="copy" size={14} class="install__copy-idle" />
              <Glyph name="check" size={14} class="install__copy-done" />
              <span class="install__label-idle install__label-short">{strings.copy}</span>
              <span class="install__label-idle install__label-long">{strings.copy_command}</span>
              <span class="install__label-done">{strings.copied}</span>
            </button>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .install {
    display: grid;
    grid-template-columns: 420px minmax(0, 1fr);
    gap: 72px;
    padding-top: 72px;
    padding-bottom: 120px;
  }

  [hidden] {
    display: none !important;
  }

  .install__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
  }

  .install__body {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
  }

  .install__card {
    align-self: start;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .install__tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: var(--bw) solid var(--border);
  }

  .install__tab {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 22px;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .install__tab:hover {
    background: var(--raised-hover);
  }

  .install__tab[aria-selected='true'] {
    background: var(--raised);
    color: var(--text-strong);
    box-shadow: inset 0 -3px 0 var(--accent-fill);
  }

  .install__lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 120px;
    padding: 28px 26px 12px;
  }

  .install__line {
    display: flex;
    gap: 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-strong);
  }

  .install__command {
    overflow-wrap: anywhere;
  }

  .install__prompt {
    color: var(--accent);
    user-select: none;
  }

  .install__file {
    align-self: flex-start;
    color: var(--link);
  }

  .install__file:hover {
    color: var(--link-hover);
  }

  .install__foot {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 26px 24px;
  }

  .install__note {
    flex-grow: 1;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .install__copy-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 34px;
    padding: 0 16px;
    border: 0;
    background: var(--raised);
    color: var(--text-strong);
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
  }

  .install__copy-button:hover {
    filter: brightness(1.08);
  }

  .install__copy-button[data-copied] {
    background: var(--success);
    color: var(--bg);
  }

  .install__copy-button :global(.install__copy-done),
  .install__label-done,
  .install__label-long,
  .install__copy-button[data-copied] :global(.install__copy-idle),
  .install__copy-button[data-copied] .install__label-idle {
    display: none;
  }

  .install__copy-button[data-copied] :global(.install__copy-done),
  .install__copy-button[data-copied] .install__label-done {
    display: inline;
  }

  @media (max-width: 1180px) {
    .install {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }

  @media (max-width: 640px) {
    .install {
      gap: 14px;
      padding-top: 56px;
      padding-bottom: 48px;
    }

    .install__copy {
      gap: 14px;
    }

    .install__copy > :not(.eyebrow),
    .install__tabs,
    .install__note {
      display: none;
    }

    .install__card {
      background: none;
      box-shadow: none;
      clip-path: none;
    }

    .install__lines {
      min-height: 0;
      padding: 16px;
      background: var(--panel);
      box-shadow: inset 0 0 0 1px var(--border);
      clip-path: polygon(
        14px 0,
        100% 0,
        100% calc(100% - 14px),
        calc(100% - 14px) 100%,
        0 100%,
        0 14px
      );
    }

    .install__line {
      gap: 0;
      font-size: 12.5px;
      word-break: break-all;
    }

    .install__prompt {
      margin-right: 1ch;
    }

    .install__foot {
      padding: 14px 0 0;
    }

    .install__copy-button {
      flex-grow: 1;
      height: 44px;
      font-size: 15px;
      font-weight: 600;
      clip-path: polygon(
        8px 0,
        100% 0,
        100% calc(100% - 8px),
        calc(100% - 8px) 100%,
        0 100%,
        0 8px
      );
    }

    .install__copy-button :global(svg) {
      width: 16px;
      height: 16px;
    }

    .install__label-short {
      display: none;
    }

    .install__label-long {
      display: inline;
    }

    .install__copy-button[data-copied] .install__label-long {
      display: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-install]');

  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-install-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-install-panel]'));

    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((other) => {
        const active = other === tab;

        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.installPanel !== tab.dataset.installTab;
      });
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;

        event.preventDefault();
        const step = event.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(index + step + tabs.length) % tabs.length];

        if (next) select(next, true);
      });
    });

    panels.forEach((panel) => {
      const button = panel.querySelector<HTMLButtonElement>('[data-install-copy]');
      let timer = 0;

      button?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(panel.dataset.copyText ?? '');
        } catch (error) {
          console.warn('Copy to clipboard failed', error);
          return;
        }

        window.clearTimeout(timer);
        button.setAttribute('data-copied', '');
        timer = window.setTimeout(() => button.removeAttribute('data-copied'), 1600);
      });
    });
  }
</script>
