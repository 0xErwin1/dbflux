---
import { DEFAULT_LOCALE, dictionary, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

interface Method {
  readonly id: string;
  readonly platform: 'linux' | 'macos' | 'windows';
  readonly label: string;
  /** A single command the reader can copy. */
  readonly command?: string;
  /** Numbered steps, for the platforms where installing is not one line. */
  readonly steps?: readonly string[];
  readonly hint: string;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = dictionary(locale);

const RELEASES = 'https://github.com/0xErwin1/dbflux/releases';

/**
 * Commands come from `docs/INSTALL.md`. Any change there has to land here in
 * the same commit — a stale install line is the most expensive typo on the
 * site. Steps and hints are translated in `src/i18n/{en,es}.ts`.
 */
const METHODS: readonly Method[] = [
  {
    id: 'tarball',
    platform: 'linux',
    label: 'Tarball',
    command:
      'curl -fsSL https://raw.githubusercontent.com/0xErwin1/dbflux/main/scripts/install.sh | sudo bash',
    hint: strings.install.hint.tarball,
  },
  {
    id: 'aur',
    platform: 'linux',
    label: 'AUR',
    command: 'paru -S dbflux',
    hint: strings.install.hint.aur,
  },
  {
    id: 'deb',
    platform: 'linux',
    label: 'deb / rpm',
    command: 'sudo dpkg -i dbflux-linux-amd64.deb',
    hint: strings.install.hint.deb,
  },
  {
    id: 'appimage',
    platform: 'linux',
    label: 'AppImage',
    command: 'chmod +x dbflux-linux-amd64.AppImage && ./dbflux-linux-amd64.AppImage',
    hint: strings.install.hint.appimage,
  },
  {
    id: 'nix',
    platform: 'linux',
    label: 'Nix',
    command: 'nix profile install github:0xErwin1/dbflux',
    hint: strings.install.hint.nix,
  },
  {
    id: 'dmg',
    platform: 'macos',
    label: 'DMG',
    steps: strings.install.steps.dmg,
    hint: strings.install.hint.dmg,
  },
  {
    id: 'installer',
    platform: 'windows',
    label: 'Installer',
    steps: strings.install.steps.installer,
    hint: strings.install.hint.installer,
  },
  {
    id: 'portable',
    platform: 'windows',
    label: 'Portable',
    steps: strings.install.steps.portable,
    hint: strings.install.hint.portable,
  },
];

const PLATFORMS = [
  { id: 'linux', label: 'Linux' },
  { id: 'macos', label: 'macOS' },
  { id: 'windows', label: 'Windows' },
] as const;
---

<div class="install" data-install>
  <div class="install__head">
    <div class="install__platforms" role="tablist" aria-label="Platform">
      {
        PLATFORMS.map((platform, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-platform-tab={platform.id}
          >
            {platform.label}
          </button>
        ))
      }
    </div>
    <a class="install__releases" href={RELEASES} rel="noopener"
      >{t(locale, 'install.all_downloads')}</a
    >
  </div>

  <div class="install__methods" role="tablist" aria-label="Installation method">
    {
      METHODS.map((method, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
          data-method-tab={method.id}
          data-method-platform={method.platform}
          hidden={method.platform !== 'linux'}
        >
          {method.label}
        </button>
      ))
    }
  </div>

  {
    METHODS.map((method, index) => (
      <div class="install__panel" data-method-panel={method.id} hidden={index !== 0}>
        {method.command && (
          <div class="install__cmd">
            <code>
              <span class="prompt">$</span> {method.command}
            </code>
            <button type="button" class="install__copy" data-copy={method.command}>
              {t(locale, 'install.copy')}
            </button>
          </div>
        )}
        {method.steps && (
          <ol class="install__steps">
            {method.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
        )}
        <p class="install__hint">{method.hint}</p>
      </div>
    ))
  }
</div>

<style>
  .install {
    background: var(--panel);
    border: var(--bw) solid var(--border);
  }

  .install__head {
    display: flex;
    align-items: stretch;
    background: var(--bg);
    border-bottom: var(--bw) solid var(--border);
  }

  .install__platforms,
  .install__methods {
    display: flex;
    overflow-x: auto;
  }

  .install__methods {
    border-bottom: var(--bw) solid var(--border);
  }

  .install__platforms button,
  .install__methods button {
    flex-shrink: 0;
    background: none;
    border: 0;
    border-right: var(--bw) solid var(--border);
    padding: var(--s-4) var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--t-instant) linear,
      background var(--t-instant) linear;
  }

  .install__platforms button:hover,
  .install__methods button:hover {
    color: var(--text-strong);
  }

  .install__platforms button[aria-selected='true'] {
    color: var(--text-strong);
    background: var(--panel);
    box-shadow: inset 0 -2px 0 0 var(--accent);
  }

  .install__methods button[aria-selected='true'] {
    color: var(--text-strong);
    background: var(--raised);
    box-shadow: inset 0 -2px 0 0 var(--accent);
  }

  .install__platforms button[hidden],
  .install__methods button[hidden] {
    display: none;
  }

  .install__releases {
    margin-left: auto;
    align-self: center;
    padding-inline: var(--s-6);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    white-space: nowrap;
  }

  .install__panel {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  /* `display: flex` above outranks the UA rule for [hidden], so the inactive
     panels have to be hidden explicitly or every method renders at once. */
  .install__panel[hidden] {
    display: none;
  }

  .install__cmd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
  }

  .install__cmd code {
    font-size: var(--fs-code);
    line-height: var(--lh-code);
    color: var(--text-strong);
    word-break: break-all;
  }

  .prompt {
    color: var(--text-muted);
  }

  .install__steps {
    margin: 0;
    padding-left: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    font-size: var(--fs-small);
    line-height: 1.65;
  }

  .install__steps::marker,
  .install__steps li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
  }

  .install__copy {
    flex-shrink: 0;
    background: none;
    border: var(--bw) solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
    transition:
      color 130ms linear,
      border-color 130ms linear;
  }

  .install__copy:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .install__hint {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .install__cmd {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-4);
    }

    .install__copy {
      min-height: var(--tap-min);
    }

    .install__releases {
      display: none;
    }
  }
</style>

<script>
  const platformTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-platform-tab]'),
  );
  const methodTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-method-tab]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-method-panel]'));

  if (platformTabs.length > 0) {
    const selectMethod = (id: string) => {
      for (const tab of methodTabs) {
        const active = tab.dataset.methodTab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden = panel.dataset.methodPanel !== id;
      }
    };

    const selectPlatform = (platform: string) => {
      for (const tab of platformTabs) {
        const active = tab.dataset.platformTab === platform;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
      }

      const visible = methodTabs.filter((tab) => tab.dataset.methodPlatform === platform);

      for (const tab of methodTabs) {
        tab.hidden = tab.dataset.methodPlatform !== platform;
      }

      if (visible[0]?.dataset.methodTab) selectMethod(visible[0].dataset.methodTab);
    };

    for (const tab of platformTabs) {
      tab.addEventListener('click', () => selectPlatform(tab.dataset.platformTab ?? 'linux'));
    }

    for (const tab of methodTabs) {
      tab.addEventListener('click', () => selectMethod(tab.dataset.methodTab ?? ''));

      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;

        event.preventDefault();
        const visible = methodTabs.filter((candidate) => !candidate.hidden);
        const position = visible.indexOf(tab);
        const step = event.key === 'ArrowRight' ? 1 : -1;
        const next = visible[(position + step + visible.length) % visible.length];

        selectMethod(next.dataset.methodTab ?? '');
        next.focus();
      });
    }

    // Open on the reader's own platform. Defaulting everyone to Linux sends a
    // Mac visitor looking for a tab before they find anything they can run.
    const agent = navigator.userAgent;
    const guess = /Mac|iPhone|iPad/.test(agent) ? 'macos' : /Win/.test(agent) ? 'windows' : 'linux';

    if (guess !== 'linux') selectPlatform(guess);

    // Keep the hero's call to action honest about where it is sending the reader.
    const cta = document.querySelector<HTMLAnchorElement>('[data-download-cta]');
    const LABELS: Record<string, string> = {
      linux: 'Download for Linux',
      macos: 'Download for macOS',
      windows: 'Download for Windows',
    };

    if (cta) cta.textContent = LABELS[guess];
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'copied';
      } catch {
        button.textContent = 'press ctrl+c';
      }

      window.setTimeout(() => {
        button.textContent = 'copy';
      }, 1600);
    });
  }
</script>
