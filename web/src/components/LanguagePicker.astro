---
import Glyph from './Glyph.astro';
import { LOCALES, LOCALE_NAMES, localeFromPathname, t, withLocale } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
  placement?: 'down-end' | 'up-end';
}

const { locale = localeFromPathname(Astro.url.pathname), placement = 'down-end' } = Astro.props;

const pathname = Astro.url.pathname;

const options = LOCALES.map((target) => ({
  locale: target,
  href: withLocale(pathname, target),
  label: LOCALE_NAMES[target],
}));
---

<div class="lang" data-lang-picker data-placement={placement}>
  <button
    type="button"
    class="lang__button c6"
    aria-expanded="false"
    aria-controls="lang-menu"
    aria-label={t(locale, 'nav.language')}
    data-lang-toggle
  >
    <Glyph name="globe" size={15} />
    <span>{LOCALE_NAMES[locale]}</span>
    <Glyph name="chevron-down" size={12} class="lang__chev" />
  </button>

  <ul class="lang__menu c12" id="lang-menu" hidden>
    {
      options.map((option) => (
        <li>
          <a
            class="c4"
            href={option.href}
            hreflang={option.locale}
            lang={option.locale}
            aria-current={option.locale === locale ? 'true' : undefined}
          >
            <span class="lang__name">{option.label}</span>
            <span class="lang__code">{option.locale}</span>
            {option.locale === locale && <Glyph name="check" size={13} class="lang__check" />}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang {
    position: relative;
  }

  .lang__button {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 12px;
    background: var(--raised);
    border: 0;
    color: var(--text-strong);
    font-size: 13px;
    cursor: pointer;
    transition: box-shadow var(--t-instant) linear;
  }

  .lang__button:hover,
  .lang__button[aria-expanded='true'] {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .lang__button :global(.lang__chev) {
    color: var(--text-muted);
  }

  .lang__menu {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: var(--z-dropdown);
    width: 220px;
    list-style: none;
    margin: 0;
    padding: 6px 0;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .lang[data-placement='up-end'] .lang__menu {
    top: auto;
    bottom: calc(100% + 8px);
  }

  .lang__menu[hidden] {
    display: none;
  }

  .lang__menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 32px;
    margin: 0 6px;
    padding: 0 10px;
    font-size: 13px;
    color: var(--text);
    transition: background 120ms linear;
  }

  .lang__menu a:hover {
    background: var(--raised-hover);
    color: var(--text-strong);
  }

  .lang__menu a[aria-current='true'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--text-strong);
  }

  .lang__name {
    flex-grow: 1;
  }

  .lang__code {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
  }

  .lang__menu :global(.lang__check) {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .lang__button {
      height: 40px;
      font-size: 13.5px;
    }

    .lang[data-placement='up-end'] .lang__menu {
      right: auto;
      left: 0;
    }
  }
</style>

<script>
  const pickers = document.querySelectorAll<HTMLElement>('[data-lang-picker]');

  pickers.forEach((picker) => {
    const toggle = picker.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const menu = picker.querySelector<HTMLElement>('.lang__menu');

    if (!toggle || !menu) return;

    const close = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = !menu.hidden;

      menu.hidden = open;
      toggle.setAttribute('aria-expanded', String(!open));
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  });
</script>
