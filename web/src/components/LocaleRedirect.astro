---
/**
 * Opens the bare root in the reader's language.
 *
 * Only `/` guesses: a URL that names a locale is never rewritten, and a choice
 * made in the language picker (stored under `dbflux-locale`) wins over the
 * browser's languages. It runs inline in the head so the redirect happens
 * before the English page paints.
 */
import { DEFAULT_LOCALE, LOCALES } from '../i18n';
---

<script
  is:inline
  data-locale-redirect
  data-locales={LOCALES.join(' ')}
  data-default-locale={DEFAULT_LOCALE}
>
  (() => {
    const { dataset } = document.currentScript;
    const locales = dataset.locales.split(' ');
    const defaultLocale = dataset.defaultLocale;
    let chosen = null;
    try {
      chosen = localStorage.getItem('dbflux-locale');
    } catch {
      // Storage can be unavailable in privacy-restricted browsing contexts.
    }
    const lowered = (tag) => tag.toLowerCase();
    const match = (language) => {
      const tag = lowered(language);
      const exact = locales.find((locale) => lowered(locale) === tag);
      if (exact) return exact;
      const [base, ...subtags] = tag.split('-');
      if (base === 'zh') {
        // The only Chinese translation uses the simplified script.
        const traditional = subtags.some((subtag) => ['hant', 'tw', 'hk', 'mo'].includes(subtag));
        return traditional
          ? null
          : (locales.find((locale) => lowered(locale) === 'zh-hans') ?? null);
      }
      return locales.find((locale) => lowered(locale) === base) ?? null;
    };
    let locale = locales.includes(chosen) ? chosen : null;
    if (locale === null) {
      const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
      for (const language of languages) {
        locale = match(language);
        if (locale !== null) break;
      }
    }
    if (locale !== null && locale !== defaultLocale) {
      location.replace(`/${locale}/${location.search}${location.hash}`);
    }
  })();
</script>
