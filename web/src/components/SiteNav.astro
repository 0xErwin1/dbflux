---
import Glyph from './Glyph.astro';
import BrandMark from './BrandMark.astro';
import { REPO } from '../data/nav';
import { docsUrl, siteUrl } from '../data/site';
import { CURRENT, productVersion } from '../data/versions';
import { localeFromPathname, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  current?: 'home' | 'docs' | 'about' | 'compare';
  locale?: Locale;
}

const { current, locale = localeFromPathname(Astro.url.pathname) } = Astro.props;

const home = siteUrl('', locale);

const LINKS = [
  { href: `${home}#drivers`, label: t(locale, 'nav.drivers'), icon: 'database', key: 'drivers' },
  { href: `${home}#keyboard`, label: t(locale, 'nav.keyboard'), icon: 'keyboard', key: 'keyboard' },
  {
    href: `${home}#governance`,
    label: t(locale, 'nav.governance'),
    icon: 'bot',
    key: 'governance',
  },
  {
    href: siteUrl('compare/', locale),
    label: t(locale, 'nav.compare'),
    icon: 'arrow-left-right',
    key: 'compare',
  },
  { href: docsUrl('', '', locale), label: t(locale, 'nav.docs'), icon: 'file-text', key: 'docs' },
  { href: siteUrl('about/', locale), label: t(locale, 'nav.about'), icon: 'layers', key: 'about' },
] as const;

const version = productVersion(CURRENT.id);
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand x" href={home}>
      <BrandMark size={28} />
      <span>DBFlux</span>
    </a>

    <nav class="nav__panel" id="nav-sheet" aria-label="Main" hidden>
      <div class="nav__links">
        {
          LINKS.map((link) => (
            <a
              href={link.href}
              class="nav__link"
              aria-current={current === link.key ? 'page' : undefined}
            >
              <Glyph name={link.icon} size={15} />
              {link.label}
            </a>
          ))
        }
        <a class="nav__link nav__link--sheet-only" href={REPO} rel="noopener">
          <Glyph name="github" size={15} />
          {t(locale, 'nav.source')}
        </a>
      </div>
    </nav>

    <span class="nav__spacer"></span>

    <span class="nav__version mono">v{version}</span>
    <a class="nav__source c7" href={REPO} rel="noopener">
      <Glyph name="github" size={16} />
      {t(locale, 'nav.source')}
    </a>
    <a class="nav__cta x c7" href={`${home}#install`}>
      <Glyph name="download" size={15} />
      {t(locale, 'nav.download')}
    </a>
    <a class="nav__cta-square c8" href={`${home}#install`} aria-label={t(locale, 'nav.download')}>
      <Glyph name="download" size={18} />
    </a>

    <button
      class="nav__toggle c8"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-sheet"
    >
      <span class="visually-hidden">{t(locale, 'nav.menu')}</span>
      <Glyph name="rows-3" size={18} />
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    background: var(--bg);
    border-bottom: var(--bw) solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: var(--content-max);
    height: var(--nav-h);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 17px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .nav__brand:hover {
    color: var(--text-strong);
  }

  .nav__panel {
    display: flex;
    align-items: center;
    margin-left: 20px;
  }

  .nav__links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text);
    transition: color var(--t-instant) linear;
  }

  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--text-strong);
  }

  .nav__link[aria-current='page'] {
    box-shadow: 0 3px 0 var(--accent-fill);
  }

  .nav__link--sheet-only {
    display: none;
  }

  .nav__spacer {
    flex-grow: 1;
  }

  .nav__version {
    font-size: 12px;
    color: var(--text-muted);
  }

  .nav__source {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    background: var(--raised);
    color: var(--text-strong);
    font-size: 13px;
    font-weight: 600;
  }

  .nav__source:hover {
    background: var(--raised-hover);
    color: var(--text-strong);
  }

  .nav__cta {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 18px;
    background: var(--accent-fill);
    color: var(--accent-on);
    font-weight: 800;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav__cta:hover {
    color: var(--accent-on);
    filter: brightness(1.08);
  }

  .nav__cta-square,
  .nav__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    padding: 0;
    border: 0;
    cursor: pointer;
  }

  .nav__cta-square {
    background: var(--accent-fill);
    color: var(--accent-on);
  }

  .nav__cta-square:hover {
    color: var(--accent-on);
  }

  .nav__toggle {
    background: var(--raised);
    color: var(--text-strong);
  }

  @media (max-width: 1180px) {
    .nav__inner {
      gap: 12px;
    }

    .nav__panel {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      margin: 0;
      max-height: calc(100dvh - var(--nav-h));
      overflow-y: auto;
      background: var(--panel);
      border-bottom: var(--bw) solid var(--border);
    }

    .nav__panel[data-open] {
      display: flex;
    }

    .nav__links {
      flex: 1;
      flex-direction: column;
      gap: 0;
      font-size: 15px;
    }

    .nav__link {
      gap: 12px;
      min-height: 52px;
      padding: 0 var(--gutter);
      border-top: var(--bw) solid var(--row-line);
    }

    .nav__link:hover {
      background: var(--raised);
    }

    .nav__link[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--accent-fill);
    }

    .nav__toggle {
      display: flex;
    }
  }

  @media (min-width: 1181px) {
    .nav__panel {
      display: flex !important;
    }
  }

  @media (max-width: 640px) {
    .nav__inner {
      gap: 10px;
    }

    .nav__brand {
      font-size: 15px;
      letter-spacing: 0;
    }

    .nav__version,
    .nav__source,
    .nav__cta {
      display: none;
    }

    .nav__link--sheet-only,
    .nav__cta-square {
      display: flex;
    }
  }
</style>

<script>
  const breakpoint = window.matchMedia('(max-width: 1180px)');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('#nav-sheet');

  if (toggle && panel) {
    const close = (returnFocus = false) => {
      const panelHasFocus =
        document.activeElement instanceof Node && panel.contains(document.activeElement);

      panel.removeAttribute('data-open');
      panel.hidden = breakpoint.matches;
      toggle.setAttribute('aria-expanded', 'false');
      if (returnFocus && panelHasFocus) toggle.focus();
    };

    const open = () => {
      panel.hidden = false;
      panel.setAttribute('data-open', '');
      toggle.setAttribute('aria-expanded', 'true');
    };

    const resetForBreakpoint = () => {
      close(true);
      if (!breakpoint.matches) panel.hidden = false;
    };

    resetForBreakpoint();
    toggle.addEventListener('click', () => {
      if (panel.hasAttribute('data-open')) close();
      else open();
    });
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) close();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.hasAttribute('data-open')) close(true);
    });
    breakpoint.addEventListener('change', resetForBreakpoint);
  }
</script>
