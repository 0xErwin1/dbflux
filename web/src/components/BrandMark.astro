---
/**
 * The application's own mark, from `resources/branding/stable/mark-small.svg`
 * and the site favicon: a chamfered byzantium tile carrying a white bolt.
 *
 * Traced verbatim rather than redrawn, so the site and the desktop client show
 * the same logo. The tile is always byzantium and the bolt always white, on
 * either theme, exactly as the app icon is.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="DBFlux"
  class={className}
  style="flex-shrink: 0"
>
  <path d="M12 0H64V52L52 64H0V12Z" fill="#702963"></path>
  <path d="M37 8L20 36H31L26 57L45 28H34L39 8Z" fill="#FFFFFF"></path>
</svg>
