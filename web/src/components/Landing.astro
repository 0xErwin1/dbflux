---
import HomeHero from './home/HomeHero.astro';
import DriverCore from './home/DriverCore.astro';
import KeyboardSection from './home/KeyboardSection.astro';
import GovernanceSection from './home/GovernanceSection.astro';
import AuditSection from './home/AuditSection.astro';
import CompareTeaser from './home/CompareTeaser.astro';
import RulesSection from './home/RulesSection.astro';
import InstallTabs from './InstallTabs.astro';
import { REPO } from '../data/nav';
import { CURRENT, productVersion } from '../data/versions';
import { SITE_ORIGIN } from '../data/site';
import { DEFAULT_LOCALE } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

/**
 * What this page is about, for the readers that do not read.
 *
 * Four unrelated projects are called dbflux, so a crawler matching on the name
 * alone has no way to tell which one this is. The prose says Rust, GPUI and
 * database client; this says the same thing in the vocabulary a search engine
 * indexes on. Every value here is derived or checked against the repository —
 * a rating or a download count nobody counted would be a fabrication.
 */
const APPLICATION = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DBFlux',
  alternateName: 'dbflux',
  url: `${SITE_ORIGIN}/`,
  description:
    'An extensible, keyboard-first database client for PostgreSQL, MySQL, SQL Server, SQLite, MongoDB, Redis, DynamoDB and more, written in Rust on GPUI.',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Database client',
  operatingSystem: 'Linux, macOS, Windows',
  softwareVersion: productVersion(CURRENT.id),
  programmingLanguage: 'Rust',
  codeRepository: REPO,
  downloadUrl: `${REPO}/releases`,
  screenshot: `${SITE_ORIGIN}/img/app-screenshot.png`,
  license: [`${REPO}/blob/main/LICENSE-MIT`, `${REPO}/blob/main/LICENSE-APACHE`],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Ignacio Perez', url: 'https://github.com/0xErwin1' },
  sameAs: [REPO],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(APPLICATION)} />

<HomeHero locale={locale} />
<DriverCore locale={locale} />
<KeyboardSection locale={locale} />
<GovernanceSection locale={locale} />
<AuditSection locale={locale} />
<CompareTeaser locale={locale} />
<RulesSection locale={locale} />
<InstallTabs locale={locale} />
