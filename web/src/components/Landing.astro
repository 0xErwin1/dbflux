---
import Icon from './Icon.astro';
import InstallTabs from './InstallTabs.astro';
import { REPO } from '../data/nav';
import { CURRENT, productVersion } from '../data/versions';
import { SITE_ORIGIN, docsUrl } from '../data/site';
import { DEFAULT_LOCALE, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const DRIVERS = [
  'PostgreSQL',
  'MySQL',
  'MariaDB',
  'SQL Server',
  'SQLite',
  'MongoDB',
  'Redis',
  'DynamoDB',
  'CloudWatch',
  'InfluxDB',
  'Redshift',
  'S3',
] as const;

const FEATURES = [
  {
    icon: 'query',
    title: t(locale, 'landing.feature.editor.title'),
    body: t(locale, 'landing.feature.editor.body'),
  },
  {
    icon: 'table',
    title: t(locale, 'landing.feature.grid.title'),
    body: t(locale, 'landing.feature.grid.body'),
  },
  {
    icon: 'chart',
    title: t(locale, 'landing.feature.charts.title'),
    body: t(locale, 'landing.feature.charts.body'),
  },
  {
    icon: 'hook',
    title: t(locale, 'landing.feature.hooks.title'),
    body: t(locale, 'landing.feature.hooks.body'),
  },
  {
    icon: 'lock',
    title: t(locale, 'landing.feature.reach.title'),
    body: t(locale, 'landing.feature.reach.body'),
  },
  {
    icon: 'shield',
    title: t(locale, 'landing.feature.audit.title'),
    body: t(locale, 'landing.feature.audit.body'),
  },
] as const;

/** The four the application's own empty state offers on a fresh install. */
const SHORTCUTS = [
  { keys: ['Ctrl', 'N'], action: t(locale, 'landing.shortcut.new_query') },
  { keys: ['Ctrl', 'Shift', 'P'], action: t(locale, 'landing.shortcut.command_palette') },
  { keys: ['Ctrl', 'O'], action: t(locale, 'landing.shortcut.open_script') },
  { keys: ['Ctrl', 'Shift', 'N'], action: t(locale, 'landing.shortcut.new_connection') },
] as const;

const DOC_CARDS = [
  {
    href: docsUrl('usage', '', locale),
    title: t(locale, 'landing.doc_card.usage.title'),
    body: t(locale, 'landing.doc_card.usage.body'),
  },
  {
    href: docsUrl('connections', '', locale),
    title: t(locale, 'landing.doc_card.connecting.title'),
    body: t(locale, 'landing.doc_card.connecting.body'),
  },
  {
    href: docsUrl('mcp_ai_integration', '', locale),
    title: t(locale, 'landing.doc_card.mcp.title'),
    body: t(locale, 'landing.doc_card.mcp.body'),
  },
] as const;

/**
 * What this page is about, for the readers that do not read.
 *
 * Four unrelated projects are called dbflux, so a crawler matching on the name
 * alone has no way to tell which one this is. The prose says Rust, GPUI and
 * database client; this says the same thing in the vocabulary a search engine
 * indexes on. Every value here is derived or checked against the repository —
 * a rating or a download count nobody counted would be a fabrication.
 */
const APPLICATION = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DBFlux',
  alternateName: 'dbflux',
  url: `${SITE_ORIGIN}/`,
  description:
    'An extensible, keyboard-first database client for PostgreSQL, MySQL, SQL Server, SQLite, MongoDB, Redis, DynamoDB and more, written in Rust on GPUI.',
  applicationCategory: 'DeveloperApplication',
  applicationSubCategory: 'Database client',
  operatingSystem: 'Linux, macOS, Windows',
  softwareVersion: productVersion(CURRENT.id),
  programmingLanguage: 'Rust',
  codeRepository: REPO,
  downloadUrl: `${REPO}/releases`,
  screenshot: `${SITE_ORIGIN}/img/app-hero.jpg`,
  license: [`${REPO}/blob/main/LICENSE-MIT`, `${REPO}/blob/main/LICENSE-APACHE`],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Ignacio Perez', url: 'https://github.com/0xErwin1' },
  sameAs: [REPO],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(APPLICATION)} />

<section class="hero shell">
  <div class="hero__copy">
    <p class="eyebrow">Rust &middot; GPUI &middot; v{productVersion(CURRENT.id)}</p>
    <h1>{t(locale, 'landing.title')}</h1>
    <p class="hero__lede">{t(locale, 'landing.lede')}</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="#install" data-download-cta
        >{t(locale, 'landing.download_linux')}</a
      >
      <a class="btn btn--secondary" href={REPO} rel="noopener">{t(locale, 'landing.view_source')}</a
      >
    </div>
    <p class="hero__meta">{t(locale, 'landing.platforms_meta')}</p>
  </div>

  <figure class="hero__shot">
    <figcaption>
      <span class="dot" aria-hidden="true"></span>
      {t(locale, 'landing.hero_caption')}
    </figcaption>
    <img src="/img/app-hero.jpg" width="1400" height="751" alt={t(locale, 'landing.hero_alt')} />
  </figure>
</section>

<section class="shell reveal" id="install">
  <InstallTabs locale={locale} />
</section>

<section class="shell reveal" id="drivers">
  <header class="sec-head">
    <p class="eyebrow">{t(locale, 'landing.drivers_eyebrow')}</p>
    <a href={docsUrl('drivers', '', locale)}>{t(locale, 'landing.drivers_link')}</a>
  </header>
  <ul class="chips">
    {DRIVERS.map((driver) => <li>{driver}</li>)}
  </ul>
  <p class="sec-note">{t(locale, 'landing.drivers_note')}</p>
</section>

<section class="shell reveal" id="features">
  <p class="eyebrow">{t(locale, 'landing.features_eyebrow')}</p>
  <ul class="features">
    {
      FEATURES.map((feature) => (
        <li>
          <Icon name={feature.icon} size={20} />
          <h2>{feature.title}</h2>
          <p>{feature.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="shell reveal split">
  <div class="split__copy">
    <p class="eyebrow">{t(locale, 'landing.keyboard_eyebrow')}</p>
    <h2>{t(locale, 'landing.keyboard_title')}</h2>
    <p>{t(locale, 'landing.keyboard_body')}</p>
    <a href={docsUrl('usage', '', locale)}>{t(locale, 'landing.keyboard_link')}</a>
  </div>
  <ul class="keys">
    {
      SHORTCUTS.map((shortcut) => (
        <li>
          <span class="keys__combo">
            {shortcut.keys.map((key, index) => (
              <>
                {index > 0 && <span class="keys__plus">+</span>}
                <kbd>{key}</kbd>
              </>
            ))}
          </span>
          <span class="keys__action">{shortcut.action}</span>
        </li>
      ))
    }
  </ul>
</section>

<section class="shell reveal cards2">
  <article>
    <p class="eyebrow eyebrow--link">{t(locale, 'landing.governance_eyebrow')}</p>
    <h2>{t(locale, 'landing.governance_title')}</h2>
    <p>{t(locale, 'landing.governance_body')}</p>
  </article>
  <article>
    <p class="eyebrow eyebrow--ok">{t(locale, 'landing.audit_eyebrow')}</p>
    <h2>{t(locale, 'landing.audit_title')}</h2>
    <p>{t(locale, 'landing.audit_body')}</p>
  </article>
</section>

<section class="shell reveal">
  <header class="sec-head">
    <p class="eyebrow">{t(locale, 'landing.docs_eyebrow')}</p>
    <a href={docsUrl('', '', locale)}>{t(locale, 'landing.docs_link')}</a>
  </header>
  <ul class="doccards">
    {
      DOC_CARDS.map((card) => (
        <li>
          <a href={card.href}>
            <h2>{card.title}</h2>
            <p>{card.body}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>
<style>
  section {
    padding-block-end: var(--s-9);
  }

  .hero {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: center;
    padding-block: var(--s-9);
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  h1 {
    font-size: clamp(2rem, 1.4rem + 1.9vw, 2.625rem);
    text-wrap: pretty;
  }

  .hero__lede {
    margin: 0;
    font-size: 1rem;
  }

  .hero__actions {
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .hero__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .hero__shot {
    margin: 0;
  }

  .hero__shot figcaption {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    background: var(--panel);
    border: var(--bw) solid var(--border);
    border-bottom: 0;
    padding: var(--s-3) var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .hero__shot img {
    border: var(--bw) solid var(--border);
    height: auto;
    transition: border-color 240ms linear;
  }

  .hero__shot img:hover {
    border-color: var(--border-interactive);
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(170, 217, 76, 0.55);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(170, 217, 76, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(170, 217, 76, 0);
    }
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--success);
    animation: pulse 2.4s ease-out infinite;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    margin-block-end: var(--s-6);
  }

  .sec-head a {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  .sec-note {
    margin: var(--s-5) 0 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .chips li {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text);
    background: var(--panel);
    border: var(--bw) solid var(--border);
    padding: var(--s-3) var(--s-5);
    transition:
      border-color 160ms linear,
      color 160ms linear,
      transform 160ms var(--ease-out);
  }

  .chips li:hover {
    border-color: var(--accent);
    color: var(--text-strong);
    transform: translateY(-2px);
  }

  .features {
    list-style: none;
    margin: var(--s-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bw);
    background: var(--border);
    border: var(--bw) solid var(--border);
  }

  .features li {
    background: var(--bg);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    transition: background 180ms linear;
  }

  .features li:hover {
    background: var(--panel);
  }

  .features :global(svg) {
    color: var(--accent);
    transition: transform 260ms var(--ease-out);
  }

  .features li:hover :global(svg) {
    transform: translateY(-2px) scale(1.06);
  }

  .features h2 {
    font-size: 0.875rem;
  }

  .features p,
  .doccards p,
  .cards2 p {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.65;
  }

  .split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--s-8);
    align-items: center;
  }

  .split__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .split__copy h2 {
    font-size: 1.75rem;
  }

  .split__copy p {
    margin: 0;
  }

  .split__copy a {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  /*
   * Two columns rather than a fixed-width first cell: the combos differ in
   * width, and Ctrl+Shift+P overflowed the fixed cell and pushed its own
   * description out of line with the others.
   */
  .keys {
    list-style: none;
    margin: 0;
    padding: var(--s-7);
    background: var(--panel);
    border: var(--bw) solid var(--border);
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: center;
    gap: var(--s-5);
  }

  .keys li {
    display: contents;
  }

  .keys__combo {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .keys kbd {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-strong);
    background: var(--raised);
    border: var(--bw) solid var(--border);
    padding: var(--s-2) var(--s-4);
    line-height: 1;
  }

  .keys__plus {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  .keys__action {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .keys {
      padding: var(--s-5);
      grid-template-columns: 1fr;
      gap: var(--s-2);
    }

    .keys__action {
      margin-block-end: var(--s-4);
    }
  }

  .cards2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .cards2 article {
    background: var(--panel);
    border: var(--bw) solid var(--border);
    padding: var(--s-7);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .cards2 h2 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .eyebrow--link {
    color: var(--link);
  }

  .eyebrow--ok {
    color: var(--success);
  }

  .doccards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .doccards a {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    height: 100%;
    background: var(--panel);
    border: var(--bw) solid var(--border);
    border-left: var(--bw-emphasis) solid var(--accent);
    padding: var(--s-6);
    color: var(--text);
    transition:
      background 160ms linear,
      transform 180ms var(--ease-out);
  }

  .doccards a:hover {
    background: var(--raised);
    transform: translateX(3px);
    text-decoration: none;
  }

  .doccards h2 {
    font-size: 0.875rem;
  }

  @media (max-width: 1024px) {
    .features,
    .doccards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero,
    .split {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-block: var(--s-7);
    }

    .cards2 {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    section {
      padding-block-end: var(--s-7);
    }

    .features,
    .doccards {
      grid-template-columns: 1fr;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
