---
import Glyph from '../Glyph.astro';
import JourneyScene from './JourneyScene.astro';
import { docsUrl } from '../../data/site';
import { DEFAULT_LOCALE, dictionary } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const landing = dictionary(locale).landing;
const strings = landing.journey;
const scenes = ['explore', 'builder', 'edit', 'visualize', 'governance'] as const;
const ids = {
  explore: 'journey-explore',
  builder: 'journey-builder',
  edit: 'journey-edit',
  visualize: 'journey-visualize',
  governance: 'governance',
} as const;
const chapters = scenes.map((scene, index) => ({
  scene,
  index,
  id: ids[scene],
  ...strings.chapters[scene],
}));
---

<section id="visual-workflow" class="journey shell" data-journey>
  <header class="journey__head reveal">
    <div>
      <p class="eyebrow">{strings.eyebrow}</p>
      <h2 class="display display--section">{strings.title}</h2>
    </div>
    <div class="journey__intro">
      <p>{strings.body}</p>
      <span class="journey__scroll mono">
        <Glyph name="chevron-down" size={14} />
        {strings.scroll_hint}
      </span>
    </div>
  </header>

  <div class="journey__track" data-journey-track style={`--journey-chapters: ${chapters.length}`}>
    <div class="journey__sticky">
      <nav class="journey__nav" aria-label={strings.nav_label} data-journey-navigation>
        <span class="journey__nav-progress" data-journey-progress></span>
        {
          chapters.map((chapter) => (
            <a class="journey__nav-link" href={`#${chapter.id}`} data-journey-nav={chapter.index}>
              <span class="mono">{String(chapter.index + 1).padStart(2, '0')}</span>
              <span>{chapter.nav}</span>
            </a>
          ))
        }
      </nav>

      <div class="journey__chapters">
        {
          chapters.map((chapter) => (
            <article
              id={chapter.id}
              class="journey__chapter"
              data-journey-chapter={chapter.index}
              data-journey-scene={chapter.scene}
            >
              <div class="journey__copy">
                <p class="journey__step mono">
                  {String(chapter.index + 1).padStart(2, '0')} /{' '}
                  {String(chapters.length).padStart(2, '0')}
                </p>
                <p class="eyebrow">{chapter.eyebrow}</p>
                <h3>{chapter.title}</h3>
                <p class="journey__body">{chapter.body}</p>
                <span class="journey__feature mono">
                  <Glyph
                    name={
                      chapter.scene === 'edit'
                        ? 'pencil'
                        : chapter.scene === 'governance'
                          ? 'lock'
                          : 'chevron-right'
                    }
                    size={13}
                  />
                  {chapter.feature}
                </span>
              </div>

              <div class="journey__visual" data-journey-visual>
                <JourneyScene scene={chapter.scene} strings={strings.ui} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <aside id="keyboard" class="journey__keyboard c12">
    <div class="journey__keyboard-keys" aria-hidden="true">
      <span class="journey__vim mono">NORMAL</span>
      <span class="journey__key mono c5">Ctrl</span>
      <span class="journey__key mono c5">Shift</span>
      <span class="journey__key journey__key--accent mono c5">P</span>
    </div>
    <div class="journey__keyboard-copy">
      <p class="eyebrow">{landing.rules.r1_title}</p>
      <p>{landing.rules.r1_body}</p>
    </div>
    <a class="go" href={docsUrl('keyboard', '', locale)}>
      {landing.keyboard.link}<Glyph name="chevron-right" size={14} class="go__chev" />
    </a>
  </aside>
</section>

<style>
  .journey {
    position: relative;
    padding-top: 110px;
  }

  .journey__head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 72px;
    align-items: end;
  }

  .journey__head h2 {
    max-width: 850px;
  }

  .journey__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 4px;
  }

  .journey__intro > p {
    margin: 0;
    color: var(--text);
    font-size: 16px;
    line-height: 1.7;
  }

  .journey__scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journey__scroll :global(.ico) {
    color: var(--accent);
  }

  .journey__track {
    position: relative;
    margin-top: 68px;
  }

  .journey__nav {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: var(--bw) solid var(--border);
    border-bottom: var(--bw) solid var(--border);
  }

  .journey__nav-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent-fill);
    transform: scaleX(0);
    transform-origin: left;
  }

  .journey__nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 56px;
    padding: 0 14px;
    color: var(--text-muted);
    font-size: 12px;
  }

  .journey__nav-link + .journey__nav-link {
    border-left: var(--bw) solid var(--border);
  }

  .journey__nav-link .mono {
    color: var(--text-faint);
    font-size: 9px;
  }

  .journey__nav-link > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .journey__nav-link:hover,
  .journey__nav-link[aria-current='step'] {
    background: var(--raised);
    color: var(--text-strong);
  }

  .journey__nav-link[aria-current='step'] .mono {
    color: var(--accent);
  }

  .journey__chapter {
    display: grid;
    grid-template-columns: minmax(260px, 0.4fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    min-height: 700px;
    padding: 72px 0;
    border-bottom: var(--bw) solid var(--border);
  }

  .journey__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .journey__step {
    margin: 0 0 8px;
    color: var(--text-faint);
    font-size: 12px;
  }

  .journey__copy h3 {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.3vw, 3.65rem);
    font-stretch: var(--stretch-display);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .journey__body {
    margin: 0;
    color: var(--text);
    font-size: 15px;
    line-height: 1.7;
  }

  .journey__feature {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .journey__visual {
    position: relative;
    min-width: 0;
    transform: perspective(1400px) rotateY(-3deg) rotateX(1deg);
    transform-style: preserve-3d;
  }

  .journey__visual::before {
    position: absolute;
    z-index: -1;
    inset: 8% -4% -6% 8%;
    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--accent-fill) 32%, transparent),
      transparent 68%
    );
    filter: blur(36px);
    content: '';
    pointer-events: none;
  }

  .journey__chapter:nth-child(even) .journey__visual {
    transform: perspective(1400px) rotateY(3deg) rotateX(1deg);
  }

  .journey__keyboard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin: 48px 0 110px;
    padding: 24px 28px;
    background: var(--band);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .journey__keyboard-keys {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .journey__vim {
    align-self: stretch;
    display: flex;
    align-items: center;
    margin-right: 6px;
    padding: 0 12px;
    background: var(--accent-fill);
    color: var(--accent-on);
    font-size: 10px;
    font-weight: 800;
  }

  .journey__key {
    display: grid;
    place-items: center;
    min-width: 42px;
    height: 36px;
    padding: 0 8px;
    background: var(--raised);
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--border-strong);
    font-size: 9px;
  }

  .journey__key--accent {
    background: var(--accent-fill);
    color: var(--accent-on);
    box-shadow: inset 0 -3px 0 var(--accent-fill-deep);
  }

  .journey__keyboard-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .journey__keyboard-copy p {
    margin: 0;
  }

  .journey__keyboard-copy > p:last-child {
    max-width: 650px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (max-width: 1180px) {
    .journey__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .journey__intro {
      max-width: 680px;
    }

    .journey__chapter {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding: 64px 0 76px;
    }

    .journey__copy {
      max-width: 650px;
    }

    .journey__visual,
    .journey__chapter:nth-child(even) .journey__visual {
      transform: none;
    }

    .journey__keyboard {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .journey__keyboard-keys {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .journey {
      padding-top: 76px;
    }

    .journey__track {
      margin-top: 42px;
    }

    .journey__nav {
      display: flex;
      margin-right: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .journey__nav::-webkit-scrollbar {
      display: none;
    }

    .journey__nav-link {
      min-width: 138px;
      flex: 1 0 auto;
    }

    .journey__chapter {
      min-height: 0;
      gap: 32px;
      padding: 52px 0 58px;
    }

    .journey__copy h3 {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .journey__keyboard {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      margin-bottom: 76px;
      padding: 22px;
    }

    .journey__keyboard-keys {
      flex-wrap: wrap;
    }

    .journey__vim {
      min-height: 36px;
    }
  }

  @media (max-width: 640px) {
    .journey__head h2 {
      font-size: 2.5rem;
    }

    .journey__intro > p {
      font-size: 15px;
    }

    .journey__body {
      font-size: 14px;
    }
  }
</style>
