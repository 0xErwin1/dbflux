---
import Glyph from '../Glyph.astro';
import JourneyScene from './JourneyScene.astro';
import { docsUrl } from '../../data/site';
import { DEFAULT_LOCALE, dictionary } from '../../i18n';
import type { Locale } from '../../i18n';
import { JOURNEY_CHAPTERS } from '../../lib/product-journey';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const landing = dictionary(locale).landing;
const strings = landing.journey;
const chapters = JOURNEY_CHAPTERS.map((chapter, index) => ({
  ...chapter,
  index,
  ...strings.chapters[chapter.scene],
}));
---

<section id="visual-workflow" class="journey shell" data-journey>
  <header class="journey__head reveal">
    <div>
      <p class="eyebrow">{strings.eyebrow}</p>
      <h2 class="display display--section">{strings.title}</h2>
    </div>
    <div class="journey__intro">
      <p>{strings.body}</p>
      <span class="journey__scroll mono">
        <Glyph name="chevron-down" size={14} />
        {strings.scroll_hint}
      </span>
    </div>
  </header>

  <div class="journey__track" data-journey-track style={`--journey-chapters: ${chapters.length}`}>
    <div class="journey__sticky">
      <nav class="journey__nav" aria-label={strings.nav_label} data-journey-navigation>
        <span class="journey__nav-progress" data-journey-progress></span>
        {
          chapters.map((chapter) => (
            <a class="journey__nav-link" href={`#${chapter.id}`} data-journey-nav={chapter.index}>
              <span class="mono">{String(chapter.index + 1).padStart(2, '0')}</span>
              <span>{chapter.nav}</span>
            </a>
          ))
        }
      </nav>

      <div class="journey__chapters">
        {
          chapters.map((chapter) => (
            <article
              id={chapter.id}
              class="journey__chapter"
              data-journey-chapter={chapter.index}
              data-journey-scene={chapter.scene}
            >
              <div class="journey__copy">
                <p class="journey__step mono">
                  {String(chapter.index + 1).padStart(2, '0')} /{' '}
                  {String(chapters.length).padStart(2, '0')}
                </p>
                <p class="eyebrow">{chapter.eyebrow}</p>
                <h3>{chapter.title}</h3>
                <p class="journey__body">{chapter.body}</p>
                <span class="journey__feature mono">
                  <Glyph
                    name={
                      chapter.scene === 'edit'
                        ? 'pencil'
                        : chapter.scene === 'governance'
                          ? 'lock'
                          : 'chevron-right'
                    }
                    size={13}
                  />
                  {chapter.feature}
                </span>
              </div>

              <div class="journey__visual" data-journey-visual>
                <JourneyScene scene={chapter.scene} strings={strings.ui} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <aside id="keyboard" class="journey__keyboard c12">
    <div class="journey__keyboard-keys" aria-hidden="true">
      <span class="journey__vim mono">NORMAL</span>
      <span class="journey__key mono c5">Ctrl</span>
      <span class="journey__key mono c5">Shift</span>
      <span class="journey__key journey__key--accent mono c5">P</span>
    </div>
    <div class="journey__keyboard-copy">
      <p class="eyebrow">{landing.rules.r1_title}</p>
      <p>{landing.rules.r1_body}</p>
    </div>
    <a class="go" href={docsUrl('keyboard', '', locale)}>
      {landing.keyboard.link}<Glyph name="chevron-right" size={14} class="go__chev" />
    </a>
  </aside>
</section>

<script>
  import {
    journeyChapterTarget,
    journeyEligibility,
    journeyProgress,
    type JourneyChapterTarget,
  } from '../../lib/product-journey';

  for (const root of document.querySelectorAll<HTMLElement>('[data-journey]')) {
    const track = root.querySelector<HTMLElement>('[data-journey-track]');
    const progressElement = root.querySelector<HTMLElement>('[data-journey-progress]');
    const chapterElements = Array.from(
      root.querySelectorAll<HTMLElement>('[data-journey-chapter]'),
    );
    const navigationLinks = Array.from(
      root.querySelectorAll<HTMLAnchorElement>('[data-journey-nav]'),
    );
    if (!track || !progressElement || chapterElements.length === 0) {
      continue;
    }

    const desktopMedia = window.matchMedia('(min-width: 1181px)');
    const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeIndex = 0;
    let syncRevision = 0;
    let initialAlignmentPending = true;
    let disposeEnhancement: (() => void) | undefined;
    let enhancedNavigation:
      ((target: JourneyChapterTarget, behavior?: ScrollBehavior) => void) | undefined;

    const updateNavigation = (progress: number) => {
      const state = journeyProgress(progress);
      activeIndex = state.activeIndex;
      root.dataset.journeyScene = state.activeScene;
      progressElement.style.transform = `scaleX(${state.progress})`;

      navigationLinks.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute('aria-current', 'step');
        else link.removeAttribute('aria-current');
      });
      chapterElements.forEach((chapter, index) => {
        chapter.toggleAttribute('data-journey-current', index === activeIndex);
      });
    };

    const clearEnhancedState = () => {
      enhancedNavigation = undefined;
      root.removeAttribute('data-journey-enhanced');
      delete root.dataset.journeyScene;
      progressElement.style.removeProperty('transform');
      navigationLinks.forEach((link) => link.removeAttribute('aria-current'));
      chapterElements.forEach((chapter) => chapter.removeAttribute('data-journey-current'));
    };

    const onChapterLink = (event: MouseEvent) => {
      if (
        !enhancedNavigation ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) {
        return;
      }

      const anchor =
        event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!anchor) return;

      const url = new URL(anchor.href, window.location.href);
      if (
        url.origin !== window.location.origin ||
        url.pathname !== window.location.pathname ||
        url.search !== window.location.search
      ) {
        return;
      }

      const target = journeyChapterTarget(url.hash);
      if (!target) return;

      event.preventDefault();
      window.history.pushState(null, '', url.hash);
      enhancedNavigation(target);
    };

    document.addEventListener('click', onChapterLink);

    const syncEnhancement = async () => {
      const revision = ++syncRevision;
      const shouldAlignInitialHash = initialAlignmentPending;
      const wasEnhanced = disposeEnhancement !== undefined;
      const previousIndex = activeIndex;
      initialAlignmentPending = false;
      disposeEnhancement?.();
      disposeEnhancement = undefined;

      if (journeyEligibility(window.innerWidth, reducedMotionMedia.matches).mode === 'static') {
        if (wasEnhanced) {
          chapterElements[previousIndex]?.scrollIntoView({
            block: 'start',
            behavior: 'instant',
          });
        }
        return;
      }

      try {
        const [{ gsap }, { ScrollTrigger }] = await Promise.all([
          import('gsap'),
          import('gsap/ScrollTrigger'),
        ]);
        if (
          revision !== syncRevision ||
          journeyEligibility(window.innerWidth, reducedMotionMedia.matches).mode === 'static'
        ) {
          return;
        }

        gsap.registerPlugin(ScrollTrigger);
        root.setAttribute('data-journey-enhanced', '');

        let alignInitialHash = () => {};

        const context = gsap.context(() => {
          gsap.set(chapterElements, {
            autoAlpha: 0,
            clipPath: 'inset(0% 0% 0% 0%)',
          });
          const firstChapter = chapterElements[0];
          if (firstChapter) gsap.set(firstChapter, { autoAlpha: 1 });

          const timeline = gsap.timeline({
            defaults: { duration: 1, ease: 'none' },
            paused: true,
          });
          // The hold keeps direct stops clear after native scroll rounds fractional pixels.
          const wipeDuration = 0.998;

          for (let index = 1; index < chapterElements.length; index += 1) {
            const previousChapter = chapterElements[index - 1];
            const currentChapter = chapterElements[index];
            if (!previousChapter || !currentChapter) continue;

            const at = index - 1;
            timeline
              .fromTo(
                previousChapter,
                { clipPath: 'inset(0% 0% 0% 0%)' },
                {
                  clipPath: 'inset(0% 100% 0% 0%)',
                  duration: wipeDuration,
                  immediateRender: false,
                },
                at,
              )
              .fromTo(
                currentChapter,
                { clipPath: 'inset(0% 0% 0% 100%)' },
                { clipPath: 'inset(0% 0% 0% 0%)', duration: wipeDuration, immediateRender: false },
                at,
              )
              .to(currentChapter, { autoAlpha: 1, duration: 0, immediateRender: false }, at + 0.001)
              .to(
                previousChapter,
                { autoAlpha: 0, duration: 0, immediateRender: false },
                at + wipeDuration,
              );
          }

          const scrollTrigger = ScrollTrigger.create({
            animation: timeline,
            trigger: track,
            start: () => {
              const navigation = document.querySelector<HTMLElement>('[data-nav]');
              return `top top+=${navigation?.offsetHeight ?? 0}`;
            },
            end: 'bottom bottom',
            scrub: true,
            invalidateOnRefresh: true,
            onRefresh: (self) => updateNavigation(self.progress),
            onUpdate: (self) => updateNavigation(self.progress),
          });

          enhancedNavigation = (target, behavior = 'instant') => {
            const distance = scrollTrigger.end - scrollTrigger.start;
            window.scrollTo({
              top: scrollTrigger.start + distance * target.progress,
              behavior,
            });
          };
        }, root);

        alignInitialHash = () => {
          const hash = window.location.hash;
          if (!hash) return;

          const target = journeyChapterTarget(hash);
          if (target) {
            enhancedNavigation?.(target);
            return;
          }
          document
            .getElementById(hash.slice(1))
            ?.scrollIntoView({ block: 'start', behavior: 'instant' });
        };

        disposeEnhancement = () => {
          window.removeEventListener('load', alignInitialHash);
          context.revert();
          clearEnhancedState();
        };

        ScrollTrigger.refresh();
        if (shouldAlignInitialHash) {
          if (document.readyState === 'complete') alignInitialHash();
          else window.addEventListener('load', alignInitialHash, { once: true });
        }
      } catch {
        // A failed optional enhancement leaves the semantic static document usable.
        clearEnhancedState();
      }
    };

    const onEligibilityChange = () => void syncEnhancement();
    desktopMedia.addEventListener('change', onEligibilityChange);
    reducedMotionMedia.addEventListener('change', onEligibilityChange);
    void syncEnhancement();
  }
</script>

<style>
  .journey {
    position: relative;
    padding-top: 110px;
  }

  .journey__head {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 72px;
    align-items: end;
  }

  .journey__head h2 {
    max-width: 850px;
  }

  .journey__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 4px;
  }

  .journey__intro > p {
    margin: 0;
    color: var(--text);
    font-size: 16px;
    line-height: 1.7;
  }

  .journey__scroll {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .journey__scroll :global(.ico) {
    color: var(--accent);
  }

  .journey__track {
    position: relative;
    margin-top: 68px;
  }

  .journey__nav {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-top: var(--bw) solid var(--border);
    border-bottom: var(--bw) solid var(--border);
  }

  .journey__nav-progress {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent-fill);
    transform: scaleX(0);
    transform-origin: left;
  }

  .journey__nav-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 56px;
    padding: 0 14px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .journey__nav-link + .journey__nav-link {
    border-left: var(--bw) solid var(--border);
  }

  .journey__nav-link .mono {
    color: var(--text-faint);
    font-size: 10px;
    font-weight: 500;
  }

  .journey__nav-link > span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .journey__nav-link:hover,
  .journey__nav-link[aria-current='step'] {
    background: var(--raised);
    color: var(--text-strong);
  }

  .journey__nav-link[aria-current='step'] .mono {
    color: var(--accent);
  }

  .journey__chapter {
    display: grid;
    grid-template-columns: minmax(260px, 0.4fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
    min-height: 700px;
    padding: 72px 0;
    border-bottom: var(--bw) solid var(--border);
  }

  .journey__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .journey__step {
    margin: 0 0 8px;
    color: var(--text-faint);
    font-size: 12px;
  }

  .journey__copy h3 {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.3vw, 3.65rem);
    font-stretch: var(--stretch-display);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .journey__body {
    margin: 0;
    color: var(--text);
    font-size: 15px;
    line-height: 1.7;
  }

  .journey__feature {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 8px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .journey__visual {
    position: relative;
    min-width: 0;
  }

  .journey__visual::before {
    position: absolute;
    z-index: -1;
    inset: 8% -4% -6% 8%;
    background: radial-gradient(
      ellipse,
      color-mix(in srgb, var(--accent-fill) 32%, transparent),
      transparent 68%
    );
    filter: blur(36px);
    content: '';
    pointer-events: none;
  }

  .journey__keyboard {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    margin: 48px 0 110px;
    padding: 24px 28px;
    background: var(--band);
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .journey__keyboard-keys {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .journey__vim {
    align-self: stretch;
    display: flex;
    align-items: center;
    margin-right: 6px;
    padding: 0 12px;
    background: var(--accent-fill);
    color: var(--accent-on);
    font-size: 10px;
    font-weight: 800;
  }

  .journey__key {
    display: grid;
    place-items: center;
    min-width: 42px;
    height: 36px;
    padding: 0 8px;
    background: var(--raised);
    color: var(--text);
    box-shadow: inset 0 -3px 0 var(--border-strong);
    font-size: 9px;
  }

  .journey__key--accent {
    background: var(--accent-fill);
    color: var(--accent-on);
    box-shadow: inset 0 -3px 0 var(--accent-fill-deep);
  }

  .journey__keyboard-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .journey__keyboard-copy p {
    margin: 0;
  }

  .journey__keyboard-copy > p:last-child {
    max-width: 650px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (min-width: 1181px) and (prefers-reduced-motion: no-preference) {
    .journey[data-journey-enhanced] .journey__track {
      height: calc(var(--journey-chapters) * 100vh);
      height: calc(var(--journey-chapters) * 100dvh);
    }

    .journey[data-journey-enhanced] .journey__sticky {
      position: sticky;
      top: var(--nav-h);
      display: flex;
      flex-direction: column;
      height: calc(100vh - var(--nav-h));
      height: calc(100dvh - var(--nav-h));
      overflow: hidden;
      background: var(--bg);
    }

    .journey[data-journey-enhanced] .journey__nav {
      z-index: 2;
      flex: none;
      background: var(--bg);
    }

    .journey[data-journey-enhanced] .journey__chapters {
      position: relative;
      flex: 1;
      min-height: 0;
    }

    .journey[data-journey-enhanced] .journey__chapter {
      position: absolute;
      inset: 0;
      height: 100%;
      min-height: 0;
      padding: clamp(24px, 4vh, 52px) 0;
      border: 0;
    }

    /* Projected, the glow outgrows its box; only the clipped sticky stage can contain it. */
    .journey[data-journey-enhanced] .journey__visual::before {
      transform: perspective(900px) rotateX(58deg) translateZ(-40px);
    }
  }

  @media (max-width: 1180px) {
    .journey__head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .journey__intro {
      max-width: 680px;
    }

    .journey__chapter {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding: 64px 0 76px;
    }

    .journey__copy {
      max-width: 650px;
    }

    /* The stacked capture reaches the gutter, so a glow past its right edge widens the page. */
    .journey__visual::before {
      right: 0;
    }

    .journey__keyboard {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .journey__keyboard-keys {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 700px) {
    .journey {
      padding-top: 76px;
    }

    .journey__track {
      margin-top: 42px;
    }

    .journey__nav {
      display: flex;
      margin-right: calc(var(--gutter) * -1);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .journey__nav::-webkit-scrollbar {
      display: none;
    }

    .journey__nav-link {
      min-width: 138px;
      flex: 1 0 auto;
    }

    .journey__chapter {
      min-height: 0;
      gap: 32px;
      padding: 52px 0 58px;
    }

    .journey__copy h3 {
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .journey__keyboard {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      margin-bottom: 76px;
      padding: 22px;
    }

    .journey__keyboard-keys {
      flex-wrap: wrap;
    }

    .journey__vim {
      min-height: 36px;
    }
  }

  @media (max-width: 640px) {
    .journey__head h2 {
      font-size: 2.5rem;
    }

    .journey__intro > p {
      font-size: 15px;
    }

    .journey__body {
      font-size: 14px;
    }
  }
</style>
