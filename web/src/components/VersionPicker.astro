---
import { getCollection } from 'astro:content';
import Glyph from './Glyph.astro';
import { pathsForVersion } from '../data/docs';
import type { DocsVersion } from '../data/versions';
import {
  CURRENT,
  VERSIONS,
  buildInfo,
  docsHref,
  versionHome,
  versionLabel,
} from '../data/versions';
import { localeFromPathname, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  version: DocsVersion;
  /** Version-less path of the page being read, absent on the index. */
  currentPath?: string;
  locale?: Locale;
}

const { version, currentPath, locale = localeFromPathname(Astro.url.pathname) } = Astro.props;

const entries = await getCollection('docs');
const build = buildInfo(version.id);

/**
 * Switching version keeps the reader on the same page where that page exists,
 * and falls back to that version's index where it does not.
 *
 * Versions genuinely differ — 0.6 has no concepts guide and no Redshift or S3
 * driver — so linking the same path across all of them would hand the reader a
 * 404 for the crime of running an older release.
 */
const targets = VERSIONS.map((candidate) => {
  const has =
    currentPath !== undefined && pathsForVersion(entries, candidate.id).includes(currentPath);

  return {
    version: candidate,
    href: has ? docsHref(`${candidate.id}/${currentPath}`, locale) : versionHome(candidate, locale),
    exact: has,
  };
});
---

<div class="picker" data-version-picker>
  <button
    type="button"
    class="picker__button c8"
    aria-expanded="false"
    aria-controls="version-menu"
    title={`${build.version} · ${build.commit} · ${build.date}`}
    data-version-toggle
  >
    <Glyph name="history" size={15} class="picker__icon" />
    <span class="picker__label x">{t(locale, 'versions.label')}</span>
    <span class="picker__value mono">{versionLabel(version)}</span>
    <Glyph name="chevron-down" size={12} class="picker__chev" />
  </button>

  <ul class="picker__menu c8" id="version-menu" hidden>
    {
      targets.map((target) => (
        <li>
          <a
            class="c4"
            href={target.href}
            aria-current={target.version.id === version.id ? 'true' : undefined}
            data-version-link={target.version.id}
          >
            <span class="mono">{versionLabel(target.version)}</span>
            {!target.exact && target.version.id !== version.id && (
              <span class="picker__tag" title={t(locale, 'versions.index_tag_title')}>
                {t(locale, 'versions.index_tag')}
              </span>
            )}
            {target.exact && target.version.id === CURRENT.id && (
              <span class="picker__tag">{t(locale, 'versions.default_tag')}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .picker {
    position: relative;
    margin-right: 24px;
  }

  .picker__button {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border: 0;
    background: var(--raised);
    color: var(--text-muted);
    text-align: left;
    cursor: pointer;
    transition: box-shadow var(--t-instant) linear;
  }

  .picker__button:hover,
  .picker__button[aria-expanded='true'] {
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .picker__label {
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .picker__value {
    flex-grow: 1;
    font-size: 13px;
    color: var(--text-strong);
  }

  .picker__button :global(.picker__chev) {
    transition: transform 160ms var(--ease-std);
  }

  .picker__button[aria-expanded='true'] :global(.picker__chev) {
    transform: rotate(180deg);
  }

  .picker__menu {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 4px);
    z-index: var(--z-dropdown);
    list-style: none;
    margin: 0;
    padding: 6px 0;
    background: var(--raised);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .picker__menu[hidden] {
    display: none;
  }

  .picker__menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    height: 32px;
    margin: 0 6px;
    padding: 0 10px;
    font-size: 13px;
    color: var(--text);
    transition: background 120ms linear;
  }

  .picker__menu a:hover {
    background: var(--raised-hover);
    color: var(--text-strong);
  }

  .picker__menu a[aria-current='true'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    color: var(--text-strong);
  }

  .picker__tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-muted);
  }
</style>

<script>
  const picker = document.querySelector<HTMLElement>('[data-version-picker]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-version-toggle]');
  const menu = document.querySelector<HTMLElement>('#version-menu');

  if (picker && toggle && menu) {
    const close = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const open = !menu.hidden;

      menu.hidden = open;
      toggle.setAttribute('aria-expanded', String(!open));
    });

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }
</script>
