---
import Icon from '../components/Icon.astro';
import { DOCS_SECTIONS, docTitle } from '../data/nav';

interface Props {
  /** Collection id of the page being read, or undefined on the docs index. */
  current?: string;
  available: readonly string[];
}

const { current, available } = Astro.props;
const known = new Set(available);

const sections = DOCS_SECTIONS.map((section) => {
  const entries = section.entries.filter((id) => known.has(id));

  return {
    ...section,
    entries,
    holdsCurrent: current !== undefined && entries.includes(current),
  };
});
---

<nav class="tree" aria-label="Documentation">
  <div class="tree__search">
    <span><Icon name="search" size={13} /> Filter the docs</span>
    <kbd>Ctrl K</kbd>
  </div>

  <ul class="tree__groups">
    {
      sections.map((section, index) => (
        <li>
          <details open={section.holdsCurrent} data-holds={section.holdsCurrent ? '' : undefined}>
            <summary>
              <span class="tree__chev"><Icon name="chevron" size={11} /></span>
              <span class="tree__num">{String(index + 1).padStart(2, '0')}</span>
              <span class="tree__title">{section.title}</span>
              <span class="tree__count">{section.entries.length}</span>
            </summary>
            <ul class="tree__leaves">
              {section.entries.map((id) => (
                <li>
                  <a href={`/docs/${id}/`} aria-current={id === current ? 'page' : undefined}>
                    {docTitle(id)}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tree {
    display: flex;
    flex-direction: column;
  }

  .tree__search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    margin: var(--s-5) var(--s-4);
    padding: var(--s-3) var(--s-4);
    background: var(--panel);
    border: var(--bw) solid var(--border-interactive);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: border-color var(--t-instant) linear;
  }

  .tree__search:hover {
    border-color: var(--text-muted);
  }

  .tree__search span {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .tree__search kbd {
    font-size: var(--fs-label);
    border: var(--bw) solid var(--border);
    padding: 1px 5px;
  }

  .tree__groups,
  .tree__leaves {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tree__groups {
    padding: var(--s-3) var(--s-2);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-4);
    cursor: pointer;
    list-style: none;
    transition: background 120ms linear;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    background: var(--panel);
  }

  details[data-holds]:not([open]) summary {
    background: var(--panel);
  }

  .tree__chev {
    display: inline-flex;
    color: var(--text-faint);
    transition: transform 160ms var(--ease-std);
  }

  details[open] .tree__chev {
    transform: rotate(90deg);
  }

  .tree__num {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--text-muted);
    width: 14px;
  }

  .tree__title {
    flex-grow: 1;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text);
  }

  details[open] .tree__title {
    color: var(--text-strong);
  }

  .tree__count {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--border);
  }

  @keyframes unfurl {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  details[open] .tree__leaves {
    animation: unfurl var(--t-quick) var(--ease-std) both;
  }

  .tree__leaves a {
    position: relative;
    display: block;
    padding: var(--s-2) var(--s-4) var(--s-2) 30px;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition:
      background 120ms linear,
      color 120ms linear;
  }

  .tree__leaves a::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }

  .tree__leaves a:hover {
    background: var(--panel);
    color: var(--text-strong);
    text-decoration: none;
  }

  .tree__leaves a[aria-current='page'] {
    background: var(--raised);
    color: var(--text-strong);
    box-shadow: inset 2px 0 0 0 var(--accent);
  }
</style>
