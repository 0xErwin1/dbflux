---
import Glyph from './Glyph.astro';
import { localizedDocTitle, sectionsFor } from '../data/docs';
import type { DocTitlesByLocale } from '../data/docs';
import type { DocsVersion } from '../data/versions';
import { docsHref } from '../data/versions';
import { localeFromPathname, sectionTitle, t } from '../i18n';
import type { Locale } from '../i18n';

interface Props {
  version: DocsVersion;
  /** Version-less path of the page being read, absent on the index. */
  current?: string;
  available: readonly string[];
  locale?: Locale;
  /** Existing translated document H1s, indexed by canonical locale id. */
  titlesByLocale?: DocTitlesByLocale;
}

const {
  version,
  current,
  available,
  locale = localeFromPathname(Astro.url.pathname),
  titlesByLocale = {},
} = Astro.props;

/** One glyph per rail section, keyed by `DocsSection.id` in `data/nav.ts`. */
const SECTION_ICONS: Readonly<Record<string, string>> = {
  start: 'zap',
  using: 'play',
  configure: 'settings',
  integrate: 'plug',
  reference: 'file-text',
  drivers: 'database',
  contribute: 'github',
};

const sections = sectionsFor(available).sections.map((section) => ({
  ...section,
  holdsCurrent: current !== undefined && section.entries.includes(current),
}));
---

<nav class="tree" aria-label="Documentation">
  <button class="tree__search c8" type="button" data-search-open>
    <Glyph name="search" size={15} />
    <span class="tree__search-label">{t(locale, 'docs_tree.search_cta')}</span>
    <kbd class="c4">Ctrl K</kbd>
  </button>

  <ul class="tree__groups">
    {
      sections.map((section) => (
        <li>
          <details open={section.holdsCurrent} data-holds={section.holdsCurrent ? '' : undefined}>
            <summary>
              <Glyph name={SECTION_ICONS[section.id] ?? 'file-text'} size={16} class="tree__icon" />
              <span class="tree__title">{sectionTitle(locale, section.id)}</span>
              <span class="tree__count mono">{section.entries.length}</span>
              <Glyph name="chevron-right" size={12} class="tree__chev" />
            </summary>
            <ul class="tree__leaves">
              {section.entries.map((id) => (
                <li>
                  <a
                    class="c6"
                    href={docsHref(`${version.id}/${id}`, locale)}
                    aria-current={id === current ? 'page' : undefined}
                  >
                    {localizedDocTitle(id, locale, titlesByLocale)}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tree {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .tree__search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    margin-right: 24px;
    padding: 0 12px;
    border: 0;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text-muted);
    font-size: 13.5px;
    text-align: left;
    cursor: pointer;
    transition: box-shadow var(--t-instant) linear;
  }

  .tree__search:hover {
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .tree__search-label {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tree__search kbd {
    flex-shrink: 0;
    padding: 2px 6px;
    background: var(--raised);
    font-size: 10.5px;
    white-space: nowrap;
  }

  .tree__groups,
  .tree__leaves {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tree__groups {
    padding-bottom: 28px;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 36px;
    padding: 0 12px;
    color: var(--text);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--text-strong);
  }

  summary :global(.tree__icon),
  summary :global(.tree__chev) {
    color: var(--text-muted);
  }

  details[open] summary {
    color: var(--text-strong);
  }

  details[open] summary :global(.tree__icon) {
    color: var(--accent);
  }

  summary :global(.tree__chev) {
    transition: transform 160ms var(--ease-std);
  }

  details[open] summary :global(.tree__chev) {
    transform: rotate(90deg);
  }

  .tree__title {
    flex-grow: 1;
  }

  .tree__count {
    font-size: 11px;
    font-weight: 400;
    color: var(--text-muted);
  }

  .tree__leaves a {
    display: flex;
    align-items: center;
    min-height: 32px;
    margin: 1px 12px 1px 38px;
    padding: 0 12px;
    font-size: 13.5px;
    color: var(--text-muted);
    transition:
      background 120ms linear,
      color 120ms linear;
  }

  .tree__leaves a:hover {
    background: var(--raised);
    color: var(--text-strong);
  }

  .tree__leaves a[aria-current='page'] {
    background: var(--accent-fill);
    color: var(--accent-on);
    font-weight: 700;
  }
</style>
