---
/**
 * An icon from the desktop client's own set, inlined at build time.
 *
 * `src/icons/ui` holds Lucide glyphs and `src/icons/brand` holds the engine
 * logos, both copied from `resources/icons/` so the site shows the exact marks
 * the app does. Lucide files already stroke with `currentColor`; brand files
 * are single-path fills and get `fill="currentColor"` here, so every icon
 * follows the colour of the text around it.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  style?: string;
}

const { name, size = 16, class: className, style } = Astro.props;

const sources = import.meta.glob<string>('../icons/*/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const key = `../icons/${name.includes('/') ? name : `ui/${name}`}.svg`;
const raw = sources[key];

if (!raw) {
  throw new Error(`Unknown icon "${name}"`);
}

const isBrand = key.includes('/brand/');
const open = raw.match(/<svg\b[^>]*>/)?.[0] ?? '<svg>';
const viewBox = open.match(/viewBox="([^"]*)"/)?.[1] ?? '0 0 24 24';
const inner = raw
  .slice(raw.indexOf(open) + open.length, raw.lastIndexOf('</svg>'))
  .replace(/<title>[\s\S]*?<\/title>/g, '');
const paint = isBrand
  ? ({ fill: 'currentColor' } as const)
  : ({
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': '2',
      'stroke-linecap': 'round',
      'stroke-linejoin': 'round',
    } as const);
---

<svg
  class:list={['ico', className]}
  width={size}
  height={size}
  viewBox={viewBox}
  aria-hidden="true"
  focusable="false"
  style={style}
  {...paint}
  set:html={inner}
/>
