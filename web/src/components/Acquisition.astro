---
import Base from '../layouts/Base.astro';
import { docsUrl } from '../data/site';
import type { AcquisitionRecord } from '../data/acquisition';

type Props = { record: AcquisitionRecord };
const { record } = Astro.props;
const canonical = new URL(record.route, Astro.site);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: record.heading,
    description: record.description,
    url: canonical.href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'DBFlux', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: record.heading, item: canonical.href },
    ],
  },
];
---

<Base
  title={record.title}
  description={record.description}
  canonicalPath={record.route}
  alternateLocales={['en']}
>
  <article>
    <nav aria-label="Breadcrumb"><a href="/">DBFlux</a> / <span>{record.heading}</span></nav>
    <h1>{record.heading}</h1>
    {record.body.map((paragraph) => <p>{paragraph}</p>)}
    <p><a href={docsUrl('install')}>Install DBFlux</a></p>
    <p><a href={docsUrl(record.docs[1])}>{record.docs[0]}</a></p>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
</Base>

<style>
  article {
    max-width: 760px;
    margin: auto;
    padding: var(--s-9) var(--s-8);
  }
  h1 {
    font-size: var(--fs-h1);
    margin-block: var(--s-6);
  }
  p {
    line-height: 1.8;
  }
</style>
