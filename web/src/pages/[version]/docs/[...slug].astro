---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { docTitle, pathsForVersion, splitId } from '../../../data/docs';
import { CURRENT, VERSIONS, versionById } from '../../../data/versions';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const others = VERSIONS.filter((version) => version.id !== CURRENT.id);

  return others.flatMap((version) => {
    const available = pathsForVersion(docs, version.id);

    return docs
      .filter((doc) => splitId(doc.id).version === version.id)
      .map((doc) => ({
        params: { version: version.id, slug: splitId(doc.id).path },
        props: { doc, available },
      }));
  });
}

const { doc, available } = Astro.props;
const { Content, headings } = await render(doc);

const { version: versionId, path } = splitId(doc.id);
const version = versionById(versionId)!;
const title = docTitle(path);
const firstParagraph = doc.body
  ?.split('\n\n')
  .map((block) => block.trim())
  .find((block) => block.length > 0 && !block.startsWith('#'));
const description = firstParagraph
  ? firstParagraph.replace(/\s+/g, ' ').slice(0, 180)
  : `${title} — DBFlux ${version.label} documentation.`;
---

<DocsLayout
  version={version}
  currentPath={path}
  available={available}
  headings={headings}
  title={title}
  description={description}
  editPath={doc.filePath?.split('/').pop()}
>
  <Content />
</DocsLayout>
