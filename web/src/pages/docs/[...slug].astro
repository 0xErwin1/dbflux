---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { docTitle, pathsForVersion, splitId } from '../../data/docs';
import { CURRENT } from '../../data/versions';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  const available = pathsForVersion(docs, CURRENT.id);

  return docs
    .filter((doc) => splitId(doc.id).version === CURRENT.id)
    .map((doc) => ({
      params: { slug: splitId(doc.id).path },
      props: { doc, available },
    }));
}

const { doc, available } = Astro.props;
const { Content, headings } = await render(doc);

const path = splitId(doc.id).path;
const title = docTitle(path);
const firstParagraph = doc.body
  ?.split('\n\n')
  .map((block) => block.trim())
  .find((block) => block.length > 0 && !block.startsWith('#'));
const description = firstParagraph
  ? firstParagraph.replace(/\s+/g, ' ').slice(0, 180)
  : `${title} — DBFlux documentation.`;
---

<DocsLayout
  version={CURRENT}
  currentPath={path}
  available={available}
  headings={headings}
  title={title}
  description={description}
  editPath={doc.filePath?.split('/').pop()}
>
  <Content />
</DocsLayout>
