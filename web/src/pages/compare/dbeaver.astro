---
import Base from '../../layouts/Base.astro';
import VsDBeaver from '../../components/compare/VsDBeaver.astro';
import { DOCS_AT_ROOT, SITE_ORIGIN } from '../../data/site';
import { dictionary } from '../../i18n';

const locale = 'en' as const;
const strings = dictionary(locale).compare_page.vs_dbeaver;
---

<Base
  title={strings.page_title}
  description={strings.page_description}
  current="compare"
  noindex={DOCS_AT_ROOT}
  canonicalPath={DOCS_AT_ROOT ? `${SITE_ORIGIN}/compare/dbeaver/` : undefined}
  locale={locale}
  translated
>
  <VsDBeaver locale={locale} />
</Base>
