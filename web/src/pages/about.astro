---
import Base from '../layouts/Base.astro';
import { REPO } from '../data/nav';

const PRINCIPLES = [
  {
    n: '01',
    title: 'Keyboard before pointer',
    body: 'If an action exists, it has a binding and a command-palette entry. The mouse is a fallback, and no workflow depends on it.',
  },
  {
    n: '02',
    title: 'The UI never knows a driver&rsquo;s name',
    body: 'Category, query language and capability flags decide what renders. A driver that needs new behaviour adds a seam to the core rather than a special case to the interface.',
  },
  {
    n: '03',
    title: 'Dense over decorative',
    body: 'Square corners, hairline borders, one accent colour, monospace throughout. Screen space belongs to your data.',
  },
  {
    n: '04',
    title: 'Nothing runs unrecorded',
    body: 'Queries, hooks, scripts and AI tool calls all write to the same audit log, redacted by default and yours alone — it never leaves the machine.',
  },
] as const;

const LAYERS = [
  { name: 'UI crates', detail: 'Six crates, zero driver dependencies and zero per-driver feature flags.', key: false },
  { name: 'App layer', detail: 'Registers drivers, resolves RPC services, owns connection state.', key: false },
  {
    name: 'Core contracts',
    detail: 'DbDriver, Connection, capabilities, metadata, language services, query generators.',
    key: true,
  },
  {
    name: 'Drivers',
    detail: 'Twelve built in as Rust crates; anything else over the RPC driver protocol.',
    key: false,
  },
] as const;
---

<Base
  title="About DBFlux"
  description="Why DBFlux exists, the principles behind it, and how the codebase is put together."
  current="about"
>
  <div class="col">
    <section class="intro">
      <p class="label">About</p>
      <h1>Why DBFlux exists</h1>
      <p>
        Every database client eventually asks you to pick a side: the fast native one that speaks a
        single engine, or the universal one that speaks all of them and makes you wait. DBFlux takes
        the third option — one driver-neutral core, drivers that plug into it, and a UI that never
        learns the name of any of them.
      </p>
      <p>
        That constraint is enforced in the code, not in a style guide. The interface adapts through
        capability flags and metadata, so a document store gets a document view and a time-series
        store gets a range picker without a single branch on a driver name. Adding a database is
        writing a driver, not patching the app.
      </p>
      <p>
        The long-term goal is stated plainly on the README: a fully open-source alternative to
        DBeaver. Rust and GPUI are how it stays fast enough to be worth switching to.
      </p>
    </section>

    <section class="reveal">
      <p class="label">Principles</p>
      <ol class="principles">
        {
          PRINCIPLES.map((principle) => (
            <li>
              <span class="principles__n">{principle.n}</span>
              <div>
                <h2 set:html={principle.title} />
                <p set:html={principle.body} />
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="reveal">
      <p class="label">How it is put together</p>
      <div class="layers">
        {
          LAYERS.map((layer) => (
            <div class="layers__row">
              <span class="layers__name">{layer.name}</span>
              <span class="layers__box" data-key={layer.key ? '' : undefined}>
                {layer.detail}
              </span>
            </div>
          ))
        }
      </div>
      <p class="muted">
        The full crate map and the cross-crate flows live in
        <a href={`${REPO}/blob/main/ARCHITECTURE.md`} rel="noopener">ARCHITECTURE.md</a>. If you want
        to write a driver, start with <a href="/docs/driver_authoring/">driver authoring</a>.
      </p>
    </section>

    <section class="reveal cards">
      <article>
        <p class="cards__title">Maintainer</p>
        <p class="muted">[YOUR NAME] &middot; [@HANDLE]</p>
      </article>
      <article>
        <p class="cards__title">Contribute</p>
        <p class="muted">
          Issues, drivers and docs are all welcome. The contributing guide covers the checks a pull
          request has to pass before review.
        </p>
        <a href={`${REPO}/blob/main/CONTRIBUTING.md`} rel="noopener">Read CONTRIBUTING &rarr;</a>
      </article>
    </section>
  </div>
</Base>

<style>
  .col {
    max-width: 780px;
    margin-inline: auto;
    padding: var(--s-9) var(--s-8) 0;
  }

  section {
    margin-block-end: var(--s-8);
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  h1 {
    font-size: var(--fs-h1);
  }

  .intro p {
    margin: 0;
    line-height: 1.85;
  }

  .label {
    margin-block-end: var(--s-5);
  }

  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    border: var(--bw) solid var(--border);
  }

  .principles li {
    display: flex;
    gap: var(--s-6);
    padding: var(--s-6);
    border-bottom: var(--bw) solid var(--border);
    transition: background 180ms linear;
  }

  .principles li:last-child {
    border-bottom: 0;
  }

  .principles li:hover {
    background: var(--panel);
  }

  .principles__n {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    transition: color 180ms linear;
  }

  .principles li:hover .principles__n {
    color: var(--accent);
  }

  .principles h2 {
    font-size: 1rem;
    margin-block-end: var(--s-3);
  }

  .principles p {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.7;
  }

  .layers {
    background: var(--panel);
    border: var(--bw) solid var(--border);
    padding: var(--s-7);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .layers__row {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }

  .layers__name {
    width: 140px;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .layers__box {
    flex-grow: 1;
    background: var(--bg);
    border: var(--bw) solid var(--border);
    padding: var(--s-4) var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    transition: transform 200ms var(--ease-out);
  }

  .layers__box[data-key] {
    border-color: var(--accent);
  }

  .layers__row:hover .layers__box {
    transform: translateX(4px);
  }

  .muted {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-5);
  }

  .cards article {
    border: var(--bw) solid var(--border);
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .cards__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cards p {
    margin: 0;
  }

  .cards a {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
  }

  @media (max-width: 900px) {
    .col {
      padding: var(--s-7) var(--s-6) 0;
    }

    .layers__row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--s-2);
    }

    .layers__name {
      width: auto;
    }

    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
