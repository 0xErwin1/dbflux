---
import Base from '../layouts/Base.astro';
import DocsTree from '../components/DocsTree.astro';
import Glyph from '../components/Glyph.astro';
import VersionPicker from '../components/VersionPicker.astro';
import { localizedDocTitle, sectionsFor } from '../data/docs';
import type { DocRoutePolicy, DocTitlesByLocale } from '../data/docs';
import type { DocsVersion } from '../data/versions';
import { CURRENT, docsHref, versionHome, versionLabel } from '../data/versions';
import { DEFAULT_LOCALE, localeFromPathname, sectionTitle, t } from '../i18n';
import type { Locale } from '../i18n';
import { searchIndexPath } from '../i18n/locale-registry.ts';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  version: DocsVersion;
  /** Version-less path of the page being read, absent on the index. */
  currentPath?: string;
  available: readonly string[];
  headings?: readonly Heading[];
  title: string;
  description?: string;
  editPath?: string;
  locale?: Locale;
  /**
   * Forwarded to `Base` — see its `translated` prop. `false` on a non-English
   * page means it is showing the English fallback, which also drives the
   * untranslated notice below and forces `noindex` regardless of `version`.
   */
  translated?: boolean;
  titlesByLocale?: DocTitlesByLocale;
  policy: DocRoutePolicy;
}

const {
  version,
  currentPath,
  available,
  headings = [],
  title,
  description,
  editPath,
  locale = localeFromPathname(Astro.url.pathname),
  translated = false,
  titlesByLocale = {},
  policy,
} = Astro.props;
const onThisPage = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showsFallback = locale !== DEFAULT_LOCALE && !translated;
const suffix = version.id === CURRENT.id ? '' : ` (${versionLabel(version)})`;
const searchIndex = searchIndexPath(version.id, CURRENT.id, locale, DEFAULT_LOCALE);

/** The rail order, flattened, so a page knows its section and its neighbours. */
const sections = sectionsFor(available).sections;
const readingOrder = sections.flatMap((section) => section.entries);
const position = currentPath === undefined ? -1 : readingOrder.indexOf(currentPath);
const section = sections.find((candidate) =>
  currentPath === undefined ? false : candidate.entries.includes(currentPath),
);
const neighbour = (offset: number) => {
  const path = position === -1 ? undefined : readingOrder[position + offset];

  return path
    ? {
        href: docsHref(`${version.id}/${path}`, locale),
        title: localizedDocTitle(path, locale, titlesByLocale),
      }
    : undefined;
};
const previous = neighbour(-1);
const next = neighbour(1);
---

<Base
  title={`${title} — DBFlux docs${suffix}`}
  description={description}
  current="docs"
  wide
  noindex={!policy.indexable}
  canonicalPath={policy.canonicalPath ?? null}
  searchIndex={searchIndex}
  locale={locale}
  alternateLocales={policy.alternateLocales}
>
  <div class="docs">
    <button
      class="docs__railtoggle"
      type="button"
      data-rail-toggle
      aria-expanded="false"
      aria-controls="docs-rail"
    >
      <span>{t(locale, 'docs_tree.rail_toggle')}</span>
      <Glyph name="chevron-down" size={14} class="docs__railtoggle-mark" />
    </button>

    <aside class="docs__rail" id="docs-rail">
      <VersionPicker version={version} currentPath={currentPath} locale={locale} />
      <DocsTree
        version={version}
        current={currentPath}
        available={available}
        locale={locale}
        titlesByLocale={titlesByLocale}
      />
    </aside>

    <article class="docs__body">
      <p class="crumbs">
        <Glyph name="file-text" size={14} />
        <a href={versionHome(version, locale)}>{t(locale, 'docs_tree.crumb_docs')}</a>
        {
          section && (
            <>
              <Glyph name="chevron-right" size={12} />
              <span>{sectionTitle(locale, section.id)}</span>
            </>
          )
        }
        <Glyph name="chevron-right" size={12} />
        <span class="crumbs__here">
          {currentPath ? title : t(locale, 'docs_tree.crumb_overview')}
        </span>
      </p>
      {
        showsFallback && currentPath && (
          <p class="docs__fallback-notice c10" role="status">
            {t(locale, 'docs_tree.not_translated')}{' '}
            <a href={docsHref(`${version.id}/${currentPath}`, DEFAULT_LOCALE)}>
              {t(locale, 'docs_tree.view_in_english')}
            </a>
          </p>
        )
      }
      <div class="prose"><slot /></div>
      {
        (previous || next) && (
          <nav class="docs__pager" aria-label={t(locale, 'docs_tree.crumb_docs')}>
            {previous ? (
              <a class="docs__pager-link c10 lift" href={previous.href} rel="prev">
                <span class="docs__pager-label">
                  <Glyph name="chevron-left" size={12} />
                  {t(locale, 'docs_tree.previous')}
                </span>
                <span class="docs__pager-title">{previous.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                class="docs__pager-link docs__pager-link--next c10 lift"
                href={next.href}
                rel="next"
              >
                <span class="docs__pager-label">
                  {t(locale, 'docs_tree.next')}
                  <Glyph name="chevron-right" size={12} />
                </span>
                <span class="docs__pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    <aside class="docs__toc">
      {
        onThisPage.length > 0 && (
          <nav aria-label={t(locale, 'docs_tree.on_this_page')} data-toc>
            <p class="toc__title x">
              <Glyph name="rows-3" size={13} />
              {t(locale, 'docs_tree.on_this_page')}
            </p>
            <div class="toc__links" data-toc-links>
              <svg class="toc__rail" aria-hidden="true" data-toc-rail>
                <path class="toc__rail-muted" data-toc-rail-muted />
                <path class="toc__rail-active" data-toc-rail-active />
                <circle class="toc__rail-end" r="2" data-toc-rail-end />
              </svg>
              <ul>
                {onThisPage.map((heading) => (
                  <li data-toc-depth={heading.depth}>
                    <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        )
      }
      {
        editPath && (
          <div class="toc__edit">
            <a href={`https://github.com/0xErwin1/dbflux/blob/main/${editPath}`} rel="noopener">
              <Glyph name="pencil" size={14} />
              {t(locale, 'docs_tree.edit_page')}
            </a>
            <a href="https://github.com/0xErwin1/dbflux/issues/new" rel="noopener">
              <Glyph name="flag" size={14} />
              {t(locale, 'docs_tree.report_issue')}
            </a>
          </div>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .docs {
    max-width: var(--docs-max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 760px) minmax(0, 1fr);
    align-items: start;
  }

  .docs__rail {
    position: sticky;
    top: var(--nav-h);
    z-index: var(--z-rail);
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: calc(100vh - var(--nav-h));
    overflow-y: auto;
    padding: 28px 0 0 28px;
    border-right: var(--bw) solid var(--border);
  }

  .docs__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 40px 0 96px 64px;
  }

  .docs__toc {
    position: sticky;
    top: var(--nav-h);
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-height: calc(100vh - var(--nav-h));
    overflow-y: auto;
    padding: 40px 48px 40px 56px;
  }

  .docs__railtoggle {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: var(--tap-min);
    padding: 0 var(--gutter);
    background: var(--panel);
    border: 0;
    border-bottom: var(--bw) solid var(--border);
    color: var(--text-strong);
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .docs__railtoggle :global(.docs__railtoggle-mark) {
    color: var(--text-muted);
    transition: transform var(--t-quick) var(--ease-std);
  }

  .docs__railtoggle[aria-expanded='true'] :global(.docs__railtoggle-mark) {
    transform: rotate(180deg);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 13px;
    color: var(--text-muted);
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs__here {
    color: var(--text-strong);
  }

  .docs__fallback-notice {
    margin: 0;
    padding: 14px 18px;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    font-size: 14px;
    color: var(--text);
  }

  .docs__pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .docs__pager-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--border);
    color: var(--text-muted);
    font-size: 12.5px;
  }

  .docs__pager-link:hover {
    color: var(--text-muted);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .docs__pager-link--next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .docs__pager-label {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .docs__pager-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text-strong);
  }

  .toc__title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 14px;
    font-weight: 800;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .toc__links {
    position: relative;
  }

  /*
   * The scroll script still measures and animates the SVG rail; the visible
   * indicator is the 2px edge on each link, so the rail is kept for geometry
   * only.
   */
  .toc__rail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
  }

  .docs__toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .docs__toc li a {
    display: block;
    padding: 6px 0 6px 14px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-muted);
    box-shadow: inset 2px 0 0 var(--border);
    transition:
      color 140ms linear,
      box-shadow 140ms linear;
  }

  .docs__toc li[data-toc-depth='3'] a {
    padding-left: 28px;
  }

  .docs__toc li a:hover {
    color: var(--text);
  }

  .docs__toc li a[data-toc-visible] {
    color: var(--accent);
    box-shadow: inset 2px 0 0 var(--accent-fill);
  }

  .docs__toc li a[aria-current='location'] {
    color: var(--text-strong);
  }

  .toc__edit {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 18px;
    font-size: 13px;
  }

  .toc__edit a {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Markdown output. The docs are authored in the repository and rendered as-is:
     their own H1 is the page heading, so the layout never adds a second one. */
  .prose {
    font-size: 16px;
    line-height: 1.7;
  }

  .prose :global(h1) {
    margin-block-end: 20px;
    font-family: var(--font-display);
    font-stretch: var(--stretch-display);
    font-size: clamp(2rem, 1.4rem + 1.6vw, 3.25rem);
    font-weight: 900;
    line-height: 0.95;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .prose :global(h1 + p) {
    font-size: 17px;
  }

  .prose :global(h2) {
    margin-block: 46px 20px;
    padding-top: 26px;
    border-top: var(--bw) solid var(--border);
    font-size: var(--fs-h2);
    font-weight: 800;
  }

  .prose :global(h3) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block: 28px 12px;
    font-size: var(--fs-h3);
  }

  .prose :global(h3)::before {
    content: '';
    flex-shrink: 0;
    width: 10px;
    height: 6px;
    background: var(--accent-fill);
    transform: skewX(-30deg);
  }

  .prose :global(h4) {
    margin-block: 22px 10px;
    font-size: 16px;
  }

  .prose :global(p),
  .prose :global(li) {
    max-width: var(--prose-max);
  }

  .prose :global(p) {
    margin-block: 0 16px;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 24px;
  }

  .prose :global(li) {
    margin-block: 6px;
  }

  .prose :global(li::marker) {
    color: var(--text-muted);
  }

  .prose :global(strong) {
    color: var(--text-strong);
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 7px;
    background: var(--raised);
    color: var(--text-strong);
    font-size: 0.8em;
    clip-path: polygon(4px 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%, 0 4px);
  }

  .prose :global(pre) {
    margin-block: 8px 20px;
    padding: 16px 18px;
    overflow-x: auto;
    background: var(--panel) !important;
    box-shadow: inset 0 0 0 1px var(--border);
    font-size: var(--fs-code);
    line-height: var(--lh-code);
    clip-path: polygon(
      14px 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      0 100%,
      0 14px
    );
  }

  .prose :global(blockquote) {
    margin: 8px 0 20px;
    padding: 18px 20px;
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    box-shadow: inset 0 0 0 1px var(--border-strong);
    font-size: 15px;
    line-height: 1.65;
    clip-path: polygon(
      10px 0,
      100% 0,
      100% calc(100% - 10px),
      calc(100% - 10px) 100%,
      0 100%,
      0 10px
    );
  }

  .prose :global(blockquote p:last-child) {
    margin: 0;
  }

  /*
   * The docs carry wide capability matrices. `display: block` turns the table
   * itself into the scroll container (rows still lay out through anonymous table
   * boxes), so columns keep their natural width instead of being crushed to the
   * prose measure, and the page body never scrolls sideways.
   */
  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 8px 20px;
    border-collapse: collapse;
    background: var(--panel);
    box-shadow: inset 0 0 0 1px var(--border);
    font-size: 14px;
    clip-path: polygon(
      14px 0,
      100% 0,
      100% calc(100% - 14px),
      calc(100% - 14px) 100%,
      0 100%,
      0 14px
    );
  }

  .prose :global(th) {
    height: 44px;
    padding: 0 18px;
    border-bottom: var(--bw) solid var(--border-strong);
    color: var(--text-strong);
    font-weight: 700;
    text-align: left;
  }

  .prose :global(td) {
    padding: 10px 18px;
    border-bottom: var(--bw) solid var(--row-line);
  }

  .prose :global(tbody tr:last-child td) {
    border-bottom: 0;
  }

  .prose :global(hr) {
    margin-block: 40px;
    border: 0;
    border-top: var(--bw) solid var(--border);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 1280px) {
    .docs {
      grid-template-columns: 280px minmax(0, 1fr);
    }

    .docs__rail {
      padding-left: 20px;
    }

    .docs__body {
      padding-right: var(--gutter);
    }

    .docs__toc {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }

    .docs__railtoggle {
      display: flex;
    }

    /*
     * The rail is a drawer here, not a stacked block. Left sticky and full
     * height it pushed a whole empty viewport between the header and the
     * article, so the reader had to scroll past nothing to reach the text.
     */
    .docs__rail {
      display: none;
      position: static;
      height: auto;
      overflow: visible;
      padding: 20px var(--gutter);
      border-right: 0;
      border-bottom: var(--bw) solid var(--border);
      background: var(--bg);
    }

    .docs__rail[data-open] {
      display: flex;
    }

    .docs__rail :global(.picker),
    .docs__rail :global(.tree__search) {
      margin-right: 0;
    }

    .docs__body {
      padding: 28px var(--gutter) 64px;
    }
  }

  @media (max-width: 640px) {
    .docs__pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .docs__pager-link--next {
      grid-column: 1;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-rail-toggle]');
  const rail = document.querySelector<HTMLElement>('#docs-rail');

  if (toggle && rail) {
    toggle.addEventListener('click', () => {
      const open = rail.hasAttribute('data-open');

      rail.toggleAttribute('data-open', !open);
      toggle.setAttribute('aria-expanded', String(!open));
    });

    // Choosing a page is the end of the drawer's job.
    rail.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('a')) return;

      rail.removeAttribute('data-open');
      toggle.setAttribute('aria-expanded', 'false');
    });
  }
</script>

<script>
  import { tocScrollDirection, visibleTocRange } from '../lib/toc-progress.ts';

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));

  function initializeToc() {
    if (links.length === 0) return;
    const tocLinks = document.querySelector<HTMLElement>('[data-toc-links]');
    const tocRail = document.querySelector<SVGSVGElement>('[data-toc-rail]');
    const mutedRail = document.querySelector<SVGPathElement>('[data-toc-rail-muted]');
    const activeRail = document.querySelector<SVGPathElement>('[data-toc-rail-active]');
    const railEnd = document.querySelector<SVGCircleElement>('[data-toc-rail-end]');

    if (tocLinks && tocRail && mutedRail && activeRail && railEnd) {
      const sections = links
        .map((link) => ({ link, heading: document.getElementById(link.dataset.tocLink ?? '') }))
        .filter(
          (entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => !!entry.heading,
        );
      if (sections.length === 0) return;

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let current: HTMLAnchorElement | null = null;
      let intervals: Array<{ start: number; end: number }> = [];
      let railLength = 0;
      let renderedRange: { start: number; end: number } | null = null;
      let targetRange: { start: number; end: number } | null = null;
      let animationFrame = 0;
      let geometryQueued = false;
      let needsMeasurement = false;
      let renderedDotDistance: number | null = null;
      let targetDotDistance: number | null = null;
      let lastScrollY = window.scrollY;
      let scrollDirection: 'up' | 'down' = 'down';

      const mark = (link: HTMLAnchorElement) => {
        if (link === current) return;
        current?.removeAttribute('aria-current');
        link.setAttribute('aria-current', 'location');
        current = link;
      };

      const railPath = (segments: readonly { x: number; top: number; bottom: number }[]) => {
        const first = segments[0];
        if (!first) return '';

        let path = `M ${first.x} ${first.top}`;
        for (const [index, segment] of segments.entries()) {
          path += ` L ${segment.x} ${segment.bottom}`;
          const next = segments[index + 1];
          if (!next) continue;
          if (segment.x === next.x) {
            path += ` L ${next.x} ${next.top}`;
            continue;
          }

          const curve = Math.min(8, Math.max(0, (next.top - segment.bottom) / 2));
          path += ` C ${segment.x} ${segment.bottom + curve}, ${next.x} ${next.top - curve}, ${next.x} ${next.top}`;
        }
        return path;
      };

      const distanceAtY = (y: number) => {
        let low = 0;
        let high = railLength;
        for (let iteration = 0; iteration < 18; iteration += 1) {
          const middle = (low + high) / 2;
          if (mutedRail.getPointAtLength(middle).y < y) low = middle;
          else high = middle;
        }
        return (low + high) / 2;
      };

      const rangeDistances = (range: { start: number; end: number }) => {
        const interpolate = (edge: 'start' | 'end', index: number) => {
          const lower = Math.floor(index);
          const value = intervals[lower]?.[edge];
          const next = intervals[lower + 1]?.[edge] ?? value;
          return value === undefined ? undefined : value + (next - value) * (index - lower);
        };
        const from = interpolate('start', range.start);
        const to = interpolate('end', range.end);
        return from === undefined || to === undefined ? null : { from, to };
      };

      const drawRailRange = (range: { start: number; end: number }, dotDistance?: number) => {
        const distances = rangeDistances(range);
        if (!distances || railLength === 0) return;

        const intervalStart = Math.min(distances.from, distances.to);
        const intervalLength = Math.max(Math.abs(distances.to - distances.from), 1);
        const endpointDistance =
          dotDistance ?? (scrollDirection === 'down' ? distances.to : distances.from);
        const endpoint = mutedRail.getPointAtLength(endpointDistance);

        activeRail.setAttribute('stroke-dasharray', `${intervalLength} ${railLength}`);
        activeRail.setAttribute('stroke-dashoffset', String(-intervalStart));
        railEnd.setAttribute('cx', String(endpoint.x));
        railEnd.setAttribute('cy', String(endpoint.y));
        railEnd.removeAttribute('display');
        renderedRange = range;
        renderedDotDistance = endpointDistance;
      };

      const clearRange = () => {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        targetRange = null;
        renderedRange = null;
        renderedDotDistance = null;
        targetDotDistance = null;
        activeRail.setAttribute('stroke-dasharray', `0 ${railLength}`);
        activeRail.setAttribute('stroke-dashoffset', '0');
        railEnd.setAttribute('display', 'none');
      };

      const animateRange = (range: { start: number; end: number }) => {
        const distances = rangeDistances(range);
        if (!distances) return;
        const dotDistance = scrollDirection === 'down' ? distances.to : distances.from;
        if (
          targetRange?.start === range.start &&
          targetRange.end === range.end &&
          targetDotDistance === dotDistance
        )
          return;

        cancelAnimationFrame(animationFrame);
        const from = renderedRange ?? range;
        const fromDotDistance = renderedDotDistance ?? dotDistance;
        targetRange = range;
        targetDotDistance = dotDistance;
        renderedRange = from;
        if (reduceMotion.matches) {
          drawRailRange(range, dotDistance);
          return;
        }

        const startedAt = performance.now();
        const frame = (now: number) => {
          const progress = Math.min((now - startedAt) / 160, 1);
          const eased = 1 - (1 - progress) ** 3;
          drawRailRange(
            {
              start: from.start + (range.start - from.start) * eased,
              end: from.end + (range.end - from.end) * eased,
            },
            fromDotDistance + (dotDistance - fromDotDistance) * eased,
          );
          if (progress < 1) animationFrame = requestAnimationFrame(frame);
          else animationFrame = 0;
        };
        animationFrame = requestAnimationFrame(frame);
      };

      const measureRail = () => {
        if (!needsMeasurement) return;
        needsMeasurement = false;
        const treeBounds = tocLinks.getBoundingClientRect();
        const segments = sections.map(({ link }) => {
          const bounds = link.getBoundingClientRect();
          return {
            x: bounds.left - treeBounds.left - 9,
            top: bounds.top - treeBounds.top,
            bottom: bounds.bottom - treeBounds.top,
          };
        });
        tocRail.setAttribute('viewBox', `0 0 ${tocLinks.clientWidth} ${tocLinks.clientHeight}`);
        const path = railPath(segments);
        mutedRail.setAttribute('d', path);
        activeRail.setAttribute('d', path);
        railLength = mutedRail.getTotalLength();
        intervals = segments.map((segment) => ({
          start: distanceAtY(segment.top),
          end: distanceAtY(segment.bottom),
        }));
        if (renderedRange) drawRailRange(renderedRange);
      };

      const sync = () => {
        const headerOffset = parseFloat(
          getComputedStyle(document.documentElement).getPropertyValue('--nav-h'),
        );
        const readingLine = headerOffset + 24;
        const positions = sections.map(({ heading, link }) => {
          const bounds = heading.getBoundingClientRect();
          return {
            top: bounds.top,
            bottom: bounds.bottom,
            depth: Number(link.closest('li')?.dataset.tocDepth) as 2 | 3,
          };
        });
        const range = visibleTocRange(positions, {
          top: headerOffset,
          bottom: window.innerHeight,
        });
        const active = sections.reduce(
          (latest, section) =>
            section.heading.getBoundingClientRect().top <= readingLine ? section : latest,
          sections[0],
        );
        mark(active.link);
        for (const [index, { link }] of sections.entries()) {
          link.toggleAttribute(
            'data-toc-visible',
            range !== null && index >= range.start && index <= range.end,
          );
        }
        if (range) animateRange(range);
        else clearRange();
      };

      const scheduleGeometry = () => {
        if (geometryQueued) return;
        geometryQueued = true;
        needsMeasurement = true;
        requestAnimationFrame(() => {
          geometryQueued = false;
          measureRail();
          sync();
        });
      };

      let queued = false;
      const scheduleSync = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          measureRail();
          sync();
        });
      };

      window.addEventListener(
        'scroll',
        () => {
          scrollDirection = tocScrollDirection(lastScrollY, window.scrollY, scrollDirection);
          lastScrollY = window.scrollY;
          scheduleSync();
        },
        { passive: true },
      );
      window.addEventListener('resize', scheduleGeometry, { passive: true });
      reduceMotion.addEventListener('change', () => {
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        if (targetRange && targetDotDistance !== null)
          drawRailRange(targetRange, targetDotDistance);
      });
      const observer = new ResizeObserver(scheduleGeometry);
      observer.observe(tocLinks);
      for (const { link } of sections) observer.observe(link);
      scheduleGeometry();
    }
  }

  initializeToc();
</script>
